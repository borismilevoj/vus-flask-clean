x="3" y="18-21" solution="IVES"/><word id="137" x="8" y="18-21" solution="RANI"/><word id="138" x="9" y="18-21" solution="AZAR"/><word id="139" x="14" y="18-21" solution="AVAR"/><word id="140" x="15" y="18-21" solution="ROVA"/><word id="141" x="21" y="18-21" solution="STAN"/><word id="142" x="5" y="19-21" solution="EZA"/><word id="143" x="10" y="19-21" solution="ČAS"/><word id="144" x="16" y="19-21" solution="VAN"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">zvok, ki izraža bolečino, žalost ali trpljenje</clue><clue word="2" number="5" citation="vpis">majhna pasma psa, ki izvira iz Tibeta. Gre za dolgodlakega psa, ki so ga prvotno vzrejali budistični menihi kot čuvaja samostanov in prinašalca sreče</clue><clue word="3" number="9" citation="vpis">kratka, humorna gledališka ali televizijska uprizoritev, ki temelji na eni sami komični situaciji ali domislici (lit.)</clue><clue word="4" number="13" citation="vpis">eden največjih in najpomembnejših narodnih parkov v Namibiji na jugozahodu Afrike</clue><clue word="5" number="18" citation="vpis">najslavnejši grški junak trojanske vojne in osrednji lik Homerjeve Iliade, Ahiles</clue><clue word="6" number="19" citation="vpis">hrvaško-slovenska vrhunska baletna umetnica, koreografinja in režiserka - Valentina (1974-)</clue><clue word="7" number="21" citation="vpis">približno 43 km dolga reka v Nemčiji, ki teče skozi Harz in severno harško predgorje v zvezni deželi Spodnja Saška</clue><clue word="8" number="22" citation="vpis">naselje v jugozahodni Franciji, v departmaju Landes (regija Nova Akvitanija)</clue><clue word="9" number="23" citation="vpis">nagnjenost k izvrševanju težjih kaznivih dejanj ali dejansko izvajanje takšnih dejanj</clue><clue word="10" number="26" citation="vpis">vrsta sladkovodne ribe iz družine postrvi (Salmonidae), ki je značilna za čiste in hladne reke in jezera, predvsem v Evropi</clue><clue word="11" number="27" citation="vpis">glavno mesto province Baoruco na jugozahodu Dominikanske republike</clue><clue word="12" number="28" citation="vpis">ena najvplivnejših evropskih intelektualk, pisateljic in političnih teoretičark na prelomu 18. v 19. stoletje - Anne Germaine de (1766†1817), (Delphine)</clue><clue word="13" number="29" citation="vpis">sledilec preroka Zaratustre, ustanovitelja zoroastrizma, ene najstarejših monoteističnih religij, ki se je razvila v antični Perziji okoli 2. tisočletja pr. n. št.</clue><clue word="14" number="31" citation="vpis">majhna občina (komuna) v departmaju Var v regiji Provansa-Alpe-Azurna obala na jugovzhodu Francije</clue><clue word="15" number="32" citation="vpis">žival, ki jo v slovenščini uradno imenujemo progasti dišavec (zool.)</clue><clue word="16" number="34" citation="vpis">vranji samec</clue><clue word="17" number="36" citation="vpis">model avtomobila italijanskega proizvajalca Fiat</clue><clue word="18" number="38" citation="vpis">okrasni grm z drobnimi belimi ali rožnatimi cvetovi in rdečimi plodovi, panešplja (vrtn.)</clue><clue word="19" number="43" citation="vpis">del ozemlja z določenimi skupnimi značilnostmi (geografskimi, kulturnimi ali gospodarskimi), (knjiž.)</clue><clue word="20" number="47" citation="vpis">grški otok v Egejskem morju, del otočja Kikladov, znan po svojih lepih plažah, živahnem nočnem življenju ter bogati zgodovini</clue><clue word="21" number="50" citation="vpis">plast zemeljske skorje, ki se nahaja pod plastjo sial (celinska skorja) in tvori dno oceanov (geol.)</clue><clue word="22" number="51" citation="vpis">svetilka, ki deluje na principu tvorbe plina acetilena (C₂H₂) s kemično reakcijo kalcijevega karbida (CaC₂) z vodo</clue><clue word="23" number="53" citation="vpis">poljski matematik, fizik in kozmolog - Andrzej Mariusz (1933-)</clue><clue word="24" number="55" citation="vpis">majhno naselje in občino v francoskem departmaju Haute-Corse (Zgornja Korzika), Francija</clue><clue word="25" number="56" citation="vpis">madžarski judovski pisatelj, pesnik in satirik - Gabor  (1884†1953)</clue><clue word="26" number="57" citation="vpis">pripadnik starodavne judovske verske skupnosti, ki je živela v obdobju pred našim štetjem in so znani po svoji asketski življenjski filozofiji, čistoči ter povezanosti s svetimi besedili, kot so Mrtvomorski zvitki</clue><clue word="27" number="58" citation="vpis">fiziološki proces nastajanja novih krvnih žil iz že obstoječega žilnega omrežja (med.)</clue><clue word="28" number="62" citation="perplexity">umetniško ime islandskega slikarja Gudmundurja Gudmundssona (1932–)</clue><clue word="29" number="63" citation="vpis">starodavno svetopisemsko mesto in današnji narodni park na sredozemski obali severnega Izraela, blizu meje z Libanonom</clue><clue word="30" number="65" citation="vpis">skupnost duhovnikov oziroma cerkvenih dostojanstvenikov v krščanski cerkvi (knjiž.)</clue><clue word="31" number="66" citation="vpis">nemško-ameriška pisateljica, najbolj znana po svojih kriminalnih in vohunskih romanih - Martha (1914†1981)</clue><clue word="32" number="68" citation="vpis">mesto na Madžarskem v županiji Pest, približno 35 km severno od Budimpešte ob Donavi</clue><clue word="33" number="70" citation="vpis">poliakrilno vlakno, mehko, toplo in lahkotno, zato ga pogosto imenujejo "umetna volna" (tekst.),</clue><clue word="34" number="74" citation="vpis">ime bangladeške političarke, nekdanje premierke Khaleda (1945-)</clue><clue word="35" number="75" citation="vpis">pogovorno ali starejše poimenovanje za osebo, ki je zbolela za tuberkulozo (jetiko)</clue><clue word="36" number="79" citation="vpis">ameriški igralec - Bill (1924†2017), (Zlata dekleta)</clue><clue word="37" number="80" citation="vpis">starodavno pristanišče in mesto v severni Afriki (današnja Tunizija), ustanovljeno s strani Feničanov okoli 1100 pr. n. št.</clue><clue word="38" number="84" citation="vpis">295 km dolga reka, ki izvira v Alpah na Tirolskem in teče skozi Bavarsko v Nemčiji, kjer se pri Deggendorfu izlije v Donavo</clue><clue word="39" number="85" citation="vpis">skupina naravnih barvil, ki dajejo rumeno, oranžno in rdečo barvo številnim rastlinam, sadju in zelenjavi (biol.)</clue><clue word="40" number="91" citation="vpis">posušen mlečni sok iz nezrelih glav makovke, rjava do črna masa z alkaloidi morfinom, kodeinom in tebainom</clue><clue word="41" number="92" citation="vpis">ozka, utrjena pot v naravi, namenjena pešcem ali planincem</clue><clue word="42" number="94" citation="vpis">avstrijsko-judovski religiozni filozof, teolog in pedagog - Martin (1878†1965), (Jaz in Ti)</clue><clue word="43" number="95" citation="vpis">izjemno velika, dolga in vodnata reka, ki ima običajno obsežno porečje in velik gospodarski, prometni ali zgodovinski pomen (ekspr.)</clue><clue word="44" number="97" citation="vpis">pomembno rimsko mesto (municipij) na območju današnjega kraja Drnovo pri Krškem</clue><clue word="45" number="99" citation="vpis">spojina, poznana tudi kot acetilen, s kemijsko formulo C₂H₂, acetilen (kem.)</clue><clue word="46" number="100" citation="vpis">plačilo, plača ali nagrada za opravljeno delo (nar.)</clue><clue word="47" number="101" citation="vpis">naselje na Hrvaškem, ki spada pod občino Krapinske Toplice v Krapinsko-zagorski županiji</clue><clue word="48" number="102" citation="vpis">optični pojav, pri katerem snov spreminja barvo glede na kot gledanja, kar ustvarja mlečen ali mavričen sijaj (fiz.)</clue><clue word="49" number="107" citation="vpis">britanski politik, premier - Anthony Robert (1897†1977)</clue><clue word="50" number="109" citation="vpis">umetniško ime brazilske pevke in igralke Marie da Graša Meneghel (1963-)</clue><clue word="51" number="110" citation="vpis">(v grški mitologiji) kralj Lokride in oče bolj znanega junaka, Malega Ajanta, ki se je boril v trojanski vojni, Oileus</clue><clue word="52" number="113" citation="vpis">(v grški mitologiji) sin kralja Evrita iz Ehallije, ki je podpiral Herakleja, ko so ga obtožili kraje očetove