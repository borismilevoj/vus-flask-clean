id="56" x="13" y="5-9" solution="NAJEM"/><word id="57" x="8" y="6-10" solution="JAILA"/><word id="58" x="14" y="6-9" solution="ANNE"/><word id="59" x="1" y="7-9" solution="ANT"/><word id="60" x="2" y="7-10" solution="NERV"/><word id="61" x="3" y="7-11" solution="ARIAL"/><word id="62" x="9" y="7-11" solution="LAPIS"/><word id="63" x="15" y="7-9" solution="AIR"/><word id="64" x="4" y="9-15" solution="KRIPELJ"/><word id="65" x="6" y="9-12" solution="KIEL"/><word id="66" x="10" y="9-15" solution="ADAPTER"/><word id="67" x="12" y="9-14" solution="SOIGRA"/><word id="68" x="5" y="10-14" solution="SCILA"/><word id="69" x="11" y="10-12" solution="ODA"/><word id="70" x="7" y="11-15" solution="JAKNA"/><word id="71" x="13" y="11-15" solution="ZOHIL"/><word id="72" x="14" y="11-15" solution="EDINA"/><word id="73" x="15" y="11-15" solution="MANUL"/><word id="74" x="8" y="12-15" solution="VLOM"/><word id="75" x="1" y="13-15" solution="ROK"/><word id="76" x="2" y="13-15" solution="ABO"/><word id="77" x="3" y="13-15" solution="KAN"/><word id="78" x="9" y="13-15" solution="ECO"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">gumijasta igralna ploščica, ki se uporablja pri hokeju na ledu</clue><clue word="2" number="4" citation="vpis">zvok, ki izraža bolečino, žalost ali trpljenje</clue><clue word="3" number="8" citation="vpis">slavna ali uspešna oseba v zabavni industriji ali športu</clue><clue word="4" number="12" citation="vpis">glavni dnevni obrok, ki ga običajno jemo sredi dneva med delom ali aktivnostmi, kosilo (knjiž.)</clue><clue word="5" number="14" citation="vpis">zunanji deli zrnja (luščine), ki odpadejo pri mletju žita</clue><clue word="6" number="15" citation="vpis">(v ljudskem izročilu) gorska vila, ki prebiva v visokogorju, varuhinja gora, ki lahko pomaga pastirjem ali pa kaznuje tiste, ki ne spoštujejo narave</clue><clue word="7" number="16" citation="vpis">izobraženi verski učenjak, ki pogosto opravlja funkcijo višjega sodnika ali pravnika</clue><clue word="8" number="17" citation="vpis">nemški igralec - Udo (1944†2025), (Jekleno nebo)</clue><clue word="9" number="18" citation="vpis">ločilno znamenje ali diakritični znak v obliki valovite črtice</clue><clue word="10" number="19" citation="vpis">elektromehanski stroj, ki ga je med drugo svetovno vojno uporabljala nacistična Nemčija za zaščito vojaških sporočil</clue><clue word="11" number="21" citation="vpis">nekdanje samostojno mesto in zdaj del mesta Reke na Hrvaškem, ki leži vzhodno od reke Rječine</clue><clue word="12" number="23">perzijski šah (1514†1576)</clue><clue word="13" number="25" citation="perplexity">skupina majhnih, dolgodlakih in nealergogenih psov, ki so priljubljeni predvsem kot družinski psi</clue><clue word="14" number="27">(v grški mitologiji) sin Gee, velikan, Antaios</clue><clue word="15" number="29" citation="vpis">rodovitna dolina v vzhodnem Libanonu, ki leži med pogorjema Libanon in Antilibanon</clue><clue word="16" number="31" citation="vpis">mesto in okraj v provinci Kerman v Iranu, ki je znano po kmetijstvu, predvsem po pridelavi pistacij</clue><clue word="17" number="34" citation="vpis">hrib, ki se nahaja približno 16 kilometrov jugovzhodno od Beograda, glavnega mesta Srbije</clue><clue word="18" number="36" citation="vpis">teta, sestra matere ali očeta (star.)</clue><clue word="19" number="38" citation="vpis">reka na Poljskem, desni pritok reke Warte, ki je ena od glavnih rek zahodne Poljske</clue><clue word="20" number="39" citation="vpis">južnokorejski proizvajalec avtomobilov</clue><clue word="21" number="40" citation="vpis">italijanska večnacionalna energetska družba s sedežem v Rimu</clue><clue word="22" number="41" citation="vpis">zvijača, prevara ali spretnost, s katero nekdo doseže določen cilj, pogosto na nepričakovan ali prebrisan način</clue><clue word="23" number="43" citation="vpis">v indijski kozmologiji (hinduizmu in budizmu) izjemno dolgo časovno obdobje, ki ustreza "dnevu Brahme"</clue><clue word="24" number="45" citation="vpis">specifično področje izobraževanja znotraj širšega programa</clue><clue word="25" number="46" citation="vpis">ameriška igralka - Diane Marie (1938†1992), (Peyton Place)</clue><clue word="26" number="48" citation="vpis">ganska pisateljica, pesnica in dramaturginja - Ama Ata (1942†2023)</clue><clue word="27" number="50" citation="vpis">izobraževalna ustanova, ki se v različnih zgodovinskih in geografskih okoljih nanaša na različne stopnje šolanja</clue><clue word="28" number="52" citation="vpis">oblika vedenja ali osebnostna lastnost, pri kateri oseba občuti užitek, zadovoljstvo ali spolno vzburjenje ob povzročanju bolečine, trpljenja ali ponižanja drugim (psiht.)</clue><clue word="29" number="56" citation="vpis">priljubljena jed iz riža, razširjena na Bližnjem vzhodu, v Srednji Aziji, na Balkanu in v Indiji</clue><clue word="30" number="58" citation="vpis">večnadstropen stolp z značilnimi navzgor zavihanimi strehami, ki je značilen za arhitekturo Vzhodne in Jugovzhodne Azije</clue><clue word="31" number="59" citation="vpis">orodje v obliki ravnila ali lopatice z gumijastim ali plastičnim robom (tisk.)</clue><clue word="32" number="62" citation="vpis">prostor v stavbi, ki je delno ali popolnoma pod zemeljsko površino</clue><clue word="33" number="64" citation="vpis">ena najpomembnejših rek v Evropi, ki teče od Švicarskih Alp do Severnega morja</clue><clue word="34" number="65" citation="vpis">mejni pas med kopnim in vodno površino (morjem, jezerom ali reko)</clue><clue word="35" number="66" citation="vpis">reka v severni Italiji (pokrajina Trentinsko), ki je desni pritok Adiže</clue><clue word="36" number="67" citation="vpis">starodavno ljudstvo na Kurilih, Japonskem in delu otoka Sahalin</clue><clue word="37" number="68" citation="vpis">edina figura v šahu, ki se premika v obliki črke "L" in lahko preskakuje druge figure</clue><clue word="38" number="69" citation="vpis">(v rimski mitologiji) sin Venere in Marsa, upodobl