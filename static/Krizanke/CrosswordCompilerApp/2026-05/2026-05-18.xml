7-19" solution="IOS"/><word id="119" x="9" y="17-19" solution="VEL"/><word id="120" x="16" y="17-19" solution="ENI"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">drugi vrhovni klan (Veliki kan) Mongolskega imperija in tretji sin slovitega Džingiskana</clue><clue word="2" number="7" citation="vpis">reka v Romuniji, ki teče skozi istoimensko mesto</clue><clue word="3" number="12" citation="vpis">majhno naselje na Hrvaškem, ki spada pod občino Dvor v Sisaško-moslavški županiji</clue><clue word="4" number="18" citation="vpis">ime slovenske igralke Juhove (1971-)</clue><clue word="5" number="19" citation="vpis">naslov obsežnega in znanega vojnega romana slovenskega pisatelja Toneta Svetine</clue><clue word="6" number="20" citation="vpis">prehodno območje med dvema različnima ekosistemoma ali biomoma (biol.)</clue><clue word="7" number="21" citation="vpis">dogma o čudežni pretvorbi substance kruha in vina v pravo telo in kri Kristusa med evharistijo, medtem ko ostaja nespremenjen zunanji videz (rel.)</clue><clue word="8" number="24" citation="vpis">kratica za Institut Jožef Stefan</clue><clue word="9" number="25" citation="vpis">knjižica, s katero študent izkazuje svoj študentski status in v katero visokošolski učitelji vpisujejo ocene in potrjujejo opravljene obveznosti</clue><clue word="10" number="26" citation="vpis">zgodovinsko mesto v italijanski deželi Marke (Marche), v provinci Ancona</clue><clue word="11" number="27" citation="perplexity">pomol iz hišnega zidu, obzidan na vseh straneh</clue><clue word="12" number="28" citation="vpis">eden največjih in mednarodno najbolj priznanih madžarskih filmskih režiserjev in scenaristov - Karoly (1925†2017), (Ljubimec)</clue><clue word="13" number="30" citation="vpis">prva šola za igralce v angleško govorečem svetu (ustanovljena 1884), kjer so se šolali zvezdniki, kot sta Robert Redford in Anne Hathaway</clue><clue word="14" number="31" citation="vpis">nenaden, nezaželen premik telesa po podlagi zaradi premajhnega trenja</clue><clue word="15" number="32" citation="perplexity">deska ali plošča iz lesa, pogosto uporabljena za različne gradbene ali gospodinjske namene (pog.)</clue><clue word="16" number="33" citation="vpis">majhno razloženo naselje na Vzhodnem Kozjanskem, ki spada pod občino Šentjur</clue><clue word="17" number="35" citation="vpis">samostojna obrambna utrdba, običajno v obliki trikotnika ali polmeseca, ki stoji zunaj glavnega obzidja gradu ali mesta</clue><clue word="18" number="37" citation="vpis">najbolj severni grški otok v Egejskem morju, ki mu zaradi bujnega rastja pravijo tudi "zeleni diamant Grčije"</clue><clue word="19" number="38" citation="vpis">svetlobni pojav, ki nastane, ko majhen delec materije (meteoroid) iz vesolja vstopi v Zemljino atmosfero in zaradi trenja zgori (astr.)</clue><clue word="20" number="40" citation="vpis">palestinski politik, ustanovitelj in voditelj teroristične organizacije Hamas - Ahmed (1937†2004)</clue><clue word="21" number="41" citation="vpis">otrok moškega spola v odnosu do svojih staršev</clue><clue word="22" number="42" citation="vpis">bliskovna luč na fotoaparatu ali splošni blisk, utrip ali hitri pojav svetlobe, bliskavica (fot.)</clue><clue word="23" number="44" citation="vpis">barva, videz ali kakovost kože na obrazu (knjiž.)</clue><clue word="24" number="45" citation="vpis">arhitekturni in etnološki pojem, značilen za ljudsko stavbarstvo na Primorskem in v Istri, ki pomeni odprt zunanji hodnik oziroma terasa pred vhodom v nadstropje hiše (nar.)</clue><clue word="25" number="49" citation="vpis">pogoj, ki ga ena stran postavi nasproti prvotnemu pogoju druge strani</clue><clue word="26" number="53" citation="vpis">srednjeveški latinski pisec, dvorjan in arhidiakon iz Walesa, ki je služil na dvoru angleškega kralja Henrika II - Walter (ok.1140†ok.1210)</clue><clue word="27" number="54" citation="vpis">nemški proizvajalec luksuznih vozil s sedežem v Ingolstadtu, ki je od leta 2020 v popolni lasti skupine Volkswagen Group</clue><clue word="28" number="55" citation="vpis">izumrlo divje govedo, ki je prednik današnjega domačega goveda (zool.)</clue><clue word="29" number="56" citation="vpis">pripadnik turškega ljudstva, ki danes živi predvsem v Tatarstanu (del Rusije) in na Krimu</clue><clue word="30" number="57" citation="vpis">plitva posoda z ravnim ali rahlo ukrivljenim dnom in nizkimi stranicami, ki jo uporabljamo za kuhanje, praženje, cvrtje in druge načine priprave hrane na štedilniku</clue><clue word="31" number="59" citation="vpis">(v grški mitologiji) sin vrhovnega boga Zevsa in nimfe Egine, eginski kralj, po smrti sodnik v podzemlju</clue><clue word="32" number="60" citation="vpis">pripadnik indoevropskega plemena, ki se je na jug današnje Italije (v regijo Kalabrija) naselilo okoli leta 1500 pr. n. št.</clue><clue word="33" number="62" citation="vpis">velika okrogla posoda, običajno iz lesa ali kovine, ki se uporablja za shranjevanje tekočin (na primer vina, piva, žganja) ali za drugo shranjevanje</clue><clue word="34" number="63" citation="vpis">nauk meniha Arija v 4. stoletju, da  Jezus Kristus ni enak Bogu Očetu, ampak je njegovo prvo in najpopolnejše ustvarjeno bitje (rel.)</clue><clue word="35" number="65" citation="vpis">obrtnik, ki izdeluje ali popravlja čelade</clue><clue word="36" number="67" citation="vpis">vzdevek slovenskega pisatelja Hinka Bratoža</clue><clue word="37" number="68" citation="vpis">tekočina, ki vsebuje ocetno kislino in nastaja z alkoholno fermentacijo, kis, jesih (star.)</clue><clue word="38" number="69" citation="vpis">kozmetični izdelek, namenjen barvanju ustnic, da jih poudari in jim da barvo; rdečilo (zastar.)</clue><clue word="39" number="70" citation="vpis">makedonski revolucionar, vodja naprednega študentskega gibanja - Todor (1919†1943)</clue><clue word="40" number="72" citation="vpis">reka na severu Švedske, Ume</clue><clue word="41" number="76" citation="vpis">od samega začetka (lat.), (dve besedi)</clue><clue word="42" number="79" citation="vpis">ameriška vrsta jabolk rdeče barve s sladko kiselkastim, sočnim mesom (agr.),</clue><clue word="43" number="81" citation="vpis">(v nordijski mitologiji) velikan, ki ni bil bog (As), je pa poosebljal morje, vladal oceanom in povzročal viharje</clue><clue word="44" number="82" citation="vpis">majhno in mirno naselje na južni obali otoka Mljet na Hrvaškem, ki leži ob robu rodovitnega polja in nad istoimenskim zalivom</clue><clue word="45" number="83" citation="vpis">mesto na Japonskem, ki se nahaja v prefekturi Kumamoto na otoku Kjušu</clue><clue word="46" number="84" citation="vpis">pripadnik indoevropske skupine narodov, ki so že pred letom 2000 pr. n. št. naseljevala območje zahodnega Balkana in del južne obale Apeninskega polotoka</clue><clue word="47" number="86" citation="vpis">slovenski pravnik in sodnik - Ivan (1937†2019)</clue><clue word="48" number="87" citation="vpis">mednarodna organizacija za begunce</clue><clue word="49" number="88">orodje oziroma pomagalo, s katerim ročno ali na stroju obdelujemo materiale (tur.)</clue><clue word="50" number="89" citation="vpis">(v grški mitologiji) trojanski starešina, znan po miroljubnosti in nasprotovanju trojanski vojni</clue><clue word="51" number="91" citation="vpis">tanko vlakno, uporabljeno za šivanje, vezenje ali pletenje, pogosto iz bombaža, svile ali sintetičnih materialov</clue><clue word="52" number="92" citation="vpis">vzetje Marije, Kristusove matere, v nebo, nebesa (rel.), (dve besedi)</clue><clue word="53" number="96" citation="vpis">četrto največje mesto v Kazahstanu in upravno središče istoimenske regije</clue><clue word="54" number="97" citation="vpis">manjše mesto v jugozahodnem delu Madžarske (županija Zala), ki leži tik ob slovenski in hrvaški meji, Lentiba</clue><clue word="55" number="98" citation="vpis">živahen ples, ki je nastal v Franciji v 19. stoletju kot del kabarejske in music-hall kulture, zlasti v Moulin Rougu v Parizu</clue><clue word="56" number="99" citation="vpis">narodni park in ognjenik na Japonskem, Aso</clue><clue word="57" number="100" citation="vpis">kockar ali igralec na srečo</clue><clue word="58" number="101" citation="vpis">mesto severno od Benetk z letalskim oporiščem, Italija</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="59" number="1" citation="vpis">stanje ali vrednost, ki je glede na dane možnosti najugodnejše ali najboljše</clue><clue word="60" number="2" citation="vpis">manjše naselje v hribovitem območju Kozjanskega</clue><clue word="61" number="3" citation="vpis">različico granita, ki je sestavljena skoraj izključno iz svetlih mineralov (alkalnih živcev in kremena)</clue><clue word="62" number="4" citation="vpis">ena najpomembnejših in najdaljših rek v Rusiji ter peta najdaljša reka v Evropi</clue><clue word="63" number="5" citation="vpis">kratica za ameriški industrijski standard na področju računalništva, gradbeništva, inženiringa in tehnologije</clue><clue word="64" number="6" citation="vpis">umetno jezero pri Kranjski Gori (ob sotočju Velike in Male Pišnice)</clue><clue word="65" number="7" citation="vpis">najslavnejši in najsposobnejši mongolski general ter glavni strateg pod Džingiskanom in njegovim naslednikom Ogatajem</clue><clue word="66" number="8">stroj za kopanje in premeščanje zemeljskega materiala (teh.)</clue><clue word="67" number="9" citation="vpis">naselje in občina v departmaju Landes, Francija</clue><clue word="68" number="10" citation="vpis">najmanjše naravno število, ki sledi ničli</clue><clue word="69" number="11" citation="vpis">visokotemperaturna oblika kalijevega glinenca, ki spada med paličaste alumosilikate (min.)</clue><clue word="70" number="12" citation="vpis">ustanovitelj podjetja za optiko v Jeni - Carl (1816†1888)</clue><clue word="71" number="13" citation="vpis">japonska znamka potrošniške elektronike, ustanovljena leta 1929</clue><clue word="72" number="14" citation="vpis">debelo, kosmato pokrivalo ali odeja (pog.)</clue><clue word="73" number="15" citation="vpis">vnetje ušesa, ki ga povzročijo bakterije, virusi ali glivice (med.)</clue><clue word="74" number="16" citation="vpis">prostor ali priprava, kjer se napaja živina ali divjad (knjiž.)</clue><clue word="75" number="17" citation="vpis">tropska rastlina iz družine bromelijevk s suličastimi listi</clue><clue word="76" number="22" citation="vpis">nasilna zamenjava oblasti</clue><clue word="77" number="23" citation="vpis">laboratorij, ki se nahaja na meji med Francijo in Švico, trenutno prehaja iz obdobja aktivnih trkov delcev v fazo obsežnih nadgradenj</clue><clue word="78" number="29" citation="vpis">trgovanje, posel, kupčija, dobičkonosno dejanje (pog.)</clue><clue word="79" number="31" citation="vpis">češka znamka športnih in akrobatskih letal</clue><clue word="80" number="32" citation="vpis">(v grški mitologiji) hči kralja Akrizija in Evridike, Zevsova ljubica</clue><clue word="81" number="34" citation="vpis">kamen, ki je na prvi pogled videti kot prva, grobo obdelana človeška naprava, a je dejansko nastal po naravni poti (arheol.)</clue><clue word="82" number="36" citation="vpis">knjižna ali znanstvena zvrst v prozi, ki obravnava temo subjektivno, a argumentirano, brez stroge strukture znanstvenega članka (lit.)</clue><clue word="83" number="37" citation="vpis"> redka, mrežasta tkanina iz bombaža, svile ali umetnih vlaken (tekst.)</clue><clue word="84" number="39" citation="vpis">popravni izpit ali naknadno priložnost za tekmovalce, ki so v prvem krogu izgubili, a se lahko skozi dodatne boje še uvrstijo v nadaljevanje (šport.)</clue><clue word="85" number="41" citation="vpis">brazilska občina v zvezni državi Bahia, ki leži v regiji Recôncavo Baiano</clue><clue word="86" number="43" citation="vpis">prenosno bivališče iz platna, kože ali umetnih vlaken, napeto čez ogrodje</clue><clue word="87" number="45" citation="vpis">strunsko glasbilo afriškega izvora, ki ga pogosto povezujemo z ameriško ljudsko, bluegr