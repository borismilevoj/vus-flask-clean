 y="14-17" solution="ISAR"/><word id="90" x="17" y="14-17" solution="OTRE"/><word id="91" x="5" y="15-17" solution="NAN"/><word id="92" x="10" y="15-17" solution="RAT"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">srednjeveško mesto na hribu v hrvaški Istri, blizu meje s Slovenijo</clue><clue word="2" number="5" citation="vpis">nekaj, kar sestavlja celoto</clue><clue word="3" number="11">znamka japonskih avtomobilov</clue><clue word="4" number="16" citation="vpis">glavno oboroženo krilo odporniškega gibanja proti okupaciji sil osi v Grčiji med drugo svetovno vojno</clue><clue word="5" number="17" citation="vpis">literarna smer v drugi polovici 20. stoletja (lit.)</clue><clue word="6" number="18" citation="vpis">gosto tkana bombažna tkanina, ki se uporablja za izdelavo prevlek za blazine in odeje, polnjene s perjem ali puhom</clue><clue word="7" number="19" citation="vpis">italijanski frančiškanski menih, teolog in kardinal  - Giovanni (1221†1274)</clue><clue word="8" number="21" citation="vpis">japonska pop pevka - Hikaru (1983-)</clue><clue word="9" number="22" citation="vpis">tropski sadež, ki v zadnjih letih velja za eno najbolj priljubljenih "superživil" tudi v Sloveniji</clue><clue word="10" number="23">sudansko govoreče ljudstvo, ki naseljuje obe obali Nila v severovzhodni Ugandi in Sudanu</clue><clue word="11" number="25" citation="vpis">pripadnik indoevropskega plemena, ki se je na jug današnje Italije (v regijo Kalabrija) naselilo okoli leta 1500 pr. n. št.</clue><clue word="12" number="26" citation="vpis">oznaka za količino, ki je po absolutni vrednosti zelo majhna, vendar ni enaka 0 (mat.)</clue><clue word="13" number="29" citation="perplexity">za polton zvišani ton e (muz.)</clue><clue word="14" number="32" citation="vpis">irska republikanska paramilitarna organizacija, ki si je prizadevala za ukinitev britanske vladavine v Severni Irski in združitev celotne Irske v republiko</clue><clue word="15" number="33" citation="vpis">rodovitno območje v puščavi, kjer je zaradi prisotnosti vode (izvir, podtalnica ali vodnjak) omogočeno uspevanje rastlin in življenje živali ter ljudi</clue><clue word="16" number="34" citation="vpis">umetni mednarodni sporazumevalni jezik, ki ga je leta 1928 ustvaril znameniti danski jezikoslovec Otto Jespersen</clue><clue word="17" number="37" citation="vpis">(v gimnastiki) osnovni element gibanja na orodju, kjer telovadec visi ali je v opori (šport.)</clue><clue word="18" number="40" citation="vpis">visoko moško pokrivalo, ki ima bogato zgodovino v Srednji Aziji, Turčiji in na Balkanu</clue><clue word="19" number="44" citation="vpis">otok v severovzhodnih Karibih, ki je edinstven zaradi svoje politične razdelitve in dveh različnih kultur na majhnem prostoru (dve besedi)</clue><clue word="20" number="47" citation="vpis">prostor, površina z določenimi skupnimi lastnostmi (knjiž.)</clue><clue word="21" number="48" citation="vpis">modro barvilo, pridobljeno iz rastline indigovec, znano tudi kot indigo (zastar.)</clue><clue word="22" number="49" citation="vpis">slovenski farmacevt - Dušan (1915†2004)</clue><clue word="23" number="50" citation="vpis">občina v zvezni državi Maranhão na severovzhodu Brazilije</clue><clue word="24" number="51" citation="vpis">močno, silovito čustvo nezadovoljstva in jeze (knjiž.)</clue><clue word="25" number="52" citation="vpis">strokovni izraz za slovar idiomatike oziroma zbirko stalnih besednih zvez, ki so značilne za določen jezik.</clue><clue word="26" number="54" citation="vpis">mesto v regiji Južna Savonija (Etelä-Savo), v bližini mesta Mikkeli na Finskem</clue><clue word="27" number="57" citation="vpis">ruska poročevalna agencija, ustanovljena leta 1961 kot naslednica dotedanjega Sovjetskega informacijskega biroja</clue><clue word="28" number="58" citation="perplexity">zagotavljanje potrebnih materialov, storitev ali pomoči za nekoga ali nekaj</clue><clue word="29" number="59" citation="vpis">(v koroškem izročilu) osrednji lik pretresljive ljudske pripovedke, ki temelji na zgodovinskem obdobju turških vpadov na Koroško</clue><clue word="30" number="61" citation="vpis">kratica za Nemško demokratično republiko (nekdaj.)</clue><clue word="31" number="63" citation="vpis">kitajsko ameriška pisateljica - Amy (1952-), (Hči kiparja kosti)</clue><clue word="32" number="64" citation="vpis">naravni rečni otok na Dravi in ena najbolj priljubljenih rekreacijskih točk v Mariboru</clue><clue word="33" number="71" citation="vpis">naselje v občini Cerknica, ki leži na robu Planinskega polja</clue><clue word="34" number="72" citation="vpis">turški politik in nekdanji general s štirimi zvezdicami - Hulusi (1952-)</clue><clue word="35" number="73" citation="vpis">nekdanji italijanski nogometaš - Angelo (1966-) (dve besedi)</clue><clue word="36" number="77" citation="vpis">srednjeveško mesto na hribu nad turističnim Rabcem v hrvaški Istri, priljubljena destinacija predvsem zaradi svoje bogate rudarske dediščine in rastoče umetniške scen, Hrvaška</clue><clue word="37" number="79" citation="vpis">stanje ali občutek osebe, ki je izgubila starše (sirota), v prenesenem pomenu pa globoko osamljenost, zapuščenost ali izgubo temeljne opore</clue><clue word="38" number="81" citation="vpis">široka pot ali ulica, ki je na obeh straneh obdana z drevoredom (knjiž.)</clue><clue word="39" number="82" citation="vpis">japonski igralec - Jun (1923†2005), (Golden Demon)</clue><clue word="40" number="83" citation="vpis">del dvojnega mesta v Nemčiji,že stoletja središče za rezanje, brušenje in trgovino z dragimi kamni   (.....-Oberstein)</clue><clue word="41" number="84" citation="vpis">samovladar, ki vlada neomejeno, brez upoštevanja zakonov in s pomočjo nasilja ali ustrahovanja (ekspr.)</clue><clue word="42" number="85" citation="vpis">ime več kraljev Nabatejskega kraljestva, ki so vladali iz klesanega mesta Petra (v današnji Jordaniji)</clue><clue word="43" number="86" citation="vpis">pomemben slovenski teolog, prevajalec in urednik, ki je pustil neizbrisen pečat pri slovenskem prevodu Svetega pisma - Frančišek (1881†1958)</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="44" number="1" citation="vpis">ime jugoslovansko-italijanska igralka Lončar, ki je bila velika filmska zvezda v 60. in 70. letih prejšnjega stoletja</clue><clue word="45" number="2" citation="vpis">količina rib, živali ali drugega plena, ki so bili prijeti oziroma ujete med ribolovom, lovom ali podobnimi dejavnostmi</clue><clue word="46" number="3" citation="vpis">japonski pisatelj znanstvene fantastike in prevajalec - Tecu (1923†2004)</clue><clue word="47" number="4" citation="vpis">japonski fizik - Leo, nobelovec leta 1973 (1925-)</clue><clue word="48" number="5" citation="vpis">kratek film, ki se predvaja pred celovečernim filmom</clue><clue word="49" number="6" citation="vpis">eden vodilnih francoskih slikarjev in soustanovitelj gibanja impresionizem - Pierre Auguste (1841†1919)</clue><clue word="50" number="7" citation="vpis">osrednji del lesene ali kovinske sadne stiskalnice (preše)</clue><clue word="51" number="8" citation="vpis">izjemno vpliven japonski pisatelj, ki velja za mojstra fantastike in nadnaravnih zgodb v moderni japonski literaturi - Kjoka (1873†1939)</clue><clue word="52" number="9" citation="vpis">pomemben slovenski prosvetni delavec, narodni buditelj in dolgoletni nadučitelj, ki je deloval predvsem na območju Štajerske - Miha (1845†1922)</clue><clue word="53" number="10" citation="vpis">španski kralj iz italijanske dinastije Savojcev - Prvi (1844†1890)</clue><clue word="54" number="11" citation="vpis">nekdanji romunski nogometaš - Iulian Ilie (1976-)</clue><clue word="55" number="12" citation="vpis"> zdravilo, ki se uporablja za preprečevanje (profilakso) in zdravljenje malarije, bolezni, ki jo povzročajo paraziti plazmodiji, prenašajo pa jo komarji mrzličarji (farm.)</clue><clue word="56" number="13" citation="vpis">ime slovenske pisateljice, prevajalke in dramaturginje Vokač (1926†1995), (Mestne gospe)</clue><clue word="57" number="14" citation="perplexity">(v grški mitologiji) atenski kipar in letalec, Ikarjev oče</clue><clue word="58" number="15" citation="vpis">sloviti kratki roman francoskega pisatelja Françoisa-Renéja de Chateaubrianda</clue><clue word="59" number="20" citation="vpis">največje turško jezero in eno največjih endoreičnih (brez odtoka) jezer na svetu</clue><clue word="60" number="24" citation="vpis">(v Bibliji) drugi judovski očak, Abrahamov in Sarin sin</clue><clue word="61" number="27" citation="vpis">kar se da komu kot dokaz priznanja za kakšno dejanje ali dosežek</clue><clue word="62" number="28" citation="vpis">junakinja romana April slovenske pisateljice M. Mihelič</clue><clue word="63" number="29" citation="vpis">majhno, a srčno britansko moštvo Formule 1, ki ga je ustanovil Morris Nunn, ki je delovalo med letoma 1973 in 1982</clue><clue word="64" number="30" citation="vpis">bolgarska kraljica (1907†2000)</clue><clue word="65" number="31" citation="vpis">kos oblačila z dolgimi rokavi, namenjen gretju zgornjega dela telesa, pulover ali jopa (knjiž.)</clue><clue word="66" number="35" citation="vpis">sodna institucija Rimskokatoliške cerkve, ustanovljena v 12. stoletju z namenom preiskovanja in zatiranja herezije oziroma krivoverstva (zgod.)</clue><clue word="67" number="36" citation="vpis">oče</clue><clue word="68" number="38" citation="vpis">ritmično ponavljanje neke pojave, na primer ritmično bitje srca ali pulza</clue><clue word="69" number="39" citation="vpis">vzdevek hrvaškega pevca zabavne glasbe Zlatana Stipišića (1968-)</clue><clue word="70" number="41" citation="vpis">skupno ime za skupino starodavnih srednjeindijskih jezikov, ki so se razvili iz sanskrta oziroma so se uporabljali vzporedno z njim</clue><clue word="71" number="42" citation="vpis">organizem ali proces, ki za svoje delovanje potrebuje kisik (biol.)</clue><clue word="72" number="43" citation="vpis">mesto v prefekturi Vakajama na osrednjem japonskem otoku Honšu</clue><clue word="73" number="45" citation="vpis">specializirano reševalno čolnasto nosilo, ki se uporablja za transport poškodovancev po snegu, akia (alp.)</clue><clue word="74" number="46" citation="vpis">veliko gorsko slano jezero na Tibetu, ki leži na nadmorski višini približno 4718 metrov</clue><clue word="75" number="50" citation="vpis">švicarska tiskovna agencija</clue><clue word="76" number="53" citation="perplexity">vnetje aorte (med.)</clue><clue word="77" number="55" citation="vpis">skupina prebavnih encimov, ki se nahajajo v želodcu sesalcev, sirilo (predvsem mladih prežvekovalcev)</clue><clue word="78" number="56" citation="vpis">sukulentna rastlina z mesnatimi listi, ki izvirajo iz Afrike in Arabskega polotoka (bot.)</clue><clue word="79" number="60" citation="vpis">rt na severni obali otoka Rugen v Nemčiji</clue><clue word="80" number="62" citation="vpis">uradno glavno mesto Tanzanije (vzhodna Afrika) in središče istoimenske regije</clue><clue word="81" number="64" citation="vpis">oseba mešanega rasnega porekla, potomca pripadnika bele rase in pripadnika črne rase (ali obratno)</clue><clue word="82" number="65" citation="vpis">kronološki zapisi ali letopisi pomembnih dogodkov, razvrščeni po letih</clue><clue word="83" number="66" citation="vpis">strmo gorsko ali hribovsko pobočje</clue><clue word="84" number="67" citation="vpis">naprava, ki deluje podobno kot laser, vendar namesto svetlobe (fotonov) oddaja usmerjen snop zvoka oziroma fononov (fiz.)</clue><clue word="85" number="68" citation="vpis">južnoafriško-britanska igralka - Alice (1954-), (Kraljica Borgov)</clue><clue word="86" number="69" citation="vpis">najbolj znan vzklik odobravanja, ki ga množica enoglasno zavpije ob uspešnem in elegantnem gibu bikoborca</clue><clue word="87" number="70" citation="vpis">turška sablja z dvoreznim rezilom</clue><clue word="88" number="74" citation="vpis">ena najpomembnejših slovenskih pedagoginj, bork za pravice žensk, soustanoviteljica OF in kasneje tragična žrtev povojnega komunističnega režima - Angela (1892†1985)</clue><clue word="89" number="75" citation="perplexity">reka, ki izvira na Tirolskem v Avstriji in teče skozi Bavarsko v Nemčiji, kjer je desni pritok Donave</clue><clue word="90" number="76" citation="vpis">ostanek oziroma odpadek preje ali prediva, ki nastane pri predelavi volne ali drugih vlaken (tekst.)</clue><clue word="91" number="78" citation="vpis">reka na Tajskem v gorovju Luang Prabang, blizu meje z Laosom</clue><clue word="92" number="80" citation="vpis">del Aleutskega otočja, ki leži v severnem Pacifiku med Aljasko (ZDA) in Rusijo</clue></clues></crossword></rectangular-puzzle></crossword-compiler-applet>
