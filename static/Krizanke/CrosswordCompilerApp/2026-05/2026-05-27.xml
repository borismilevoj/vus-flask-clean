on="KORB"/><word id="56" x="11" y="5-7" solution="VOL"/><word id="57" x="4" y="6-12" solution="ŠATULJA"/><word id="58" x="8" y="6-10" solution="SPRUK"/><word id="59" x="14" y="6-9" solution="AARE"/><word id="60" x="15" y="6-9" solution="RIOM"/><word id="61" x="1" y="7-10" solution="ŽAKL"/><word id="62" x="2" y="7-10" solution="UNAU"/><word id="63" x="3" y="7-15" solution="REZBARIJA"/><word id="64" x="9" y="8-13" solution="ŠTIBRA"/><word id="65" x="10" y="8-11" solution="ČEPA"/><word id="66" x="5" y="9-11" solution="SAD"/><word id="67" x="6" y="10-15" solution="NIRALA"/><word id="68" x="7" y="10-15" solution="SNOVIK"/><word id="69" x="11" y="10-15" solution="SLEPKA"/><word id="70" x="13" y="11-15" solution="ARATA"/><word id="71" x="14" y="11-15" solution="POVED"/><word id="72" x="15" y="11-15" solution="OMARA"/><word id="73" x="1" y="12-15" solution="OURO"/><word id="74" x="2" y="12-15" solution="KRUH"/><word id="75" x="8" y="12-15" solution="ANNA"/><word id="76" x="12" y="12-15" solution="ARUN"/><word id="77" x="5" y="13-15" solution="JOK"/><word id="78" x="10" y="13-15" solution="USK"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">nekdaj samostojno naselje, ki je danes del mestnega naselja Ljubljana</clue><clue word="2" number="7" citation="vpis">(v slovenski mitologiji in literaturi) majhno, spačeno bitje, podobno škratu ali vili</clue><clue word="3" number="11" citation="vpis">pametna platforma Telekoma Slovenije za domačo zabavo in upravljanje pametnega doma</clue><clue word="4" number="14" citation="vpis">(v grški mitologiji) gorska nimfa ali vila</clue><clue word="5" number="15" citation="vpis">kost podlahtnica, pomemben del človeškega okostja, saj je ena od dveh kosti podlakti. Nahaja se na medialni strani podlakti (proti mezincu) in ima ključno vlogo pri gibanju podlakti in roke (anat.)</clue><clue word="6" number="16" citation="vpis">francoska tiskovna agencija</clue><clue word="7" number="17" citation="vpis">gledališka, baletna in operna hiša iz Moskve, Rusija (dve besedi)</clue><clue word="8" number="19" citation="vpis">barva, videz ali kakovost kože na obrazu (knjiž.)</clue><clue word="9" number="20" citation="vpis">(v grški mitologiji) mogočen velikan, sin boga morja Pozejdona in boginje zemlje Gaje</clue><clue word="10" number="21" citation="vpis">bosansko-slovenski pesnik, pisatelj, prevajalec, urednik in kritik - Josip (1945†2021), (Kraški narcis)</clue><clue word="11" number="22">posoda, običajno izdelana iz stekla, keramike, porcelana ali kovine, ki se uporablja za hranjenje in razstavljanje cvetja</clue><clue word="12" number="23" citation="vpis">(v egipčanski mitologiji) bog sonca, najvišji bog starega Egipta, Ra</clue><clue word="13" number="24" citation="vpis">politična komedija slovenskega pisatelja in dramatika Toneta Čufarja, napisana leta 1934</clue><clue word="14" number="26" citation="vpis">mesto v okrožju Brazoria v ameriški zvezni državi Teksas, približno 40 kilometrov jugovzhodno od centra Houston</clue><clue word="15" number="28" citation="vpis">ena najbolj priljubljenih in prepoznavnih pasem psov na svetu, predvsem po zaslugi legendarne filmske junakinje Lassie (dve besedi)</clue><clue word="16" number="32" citation="vpis">slovenski politik, organizator dela in dolgoletni direktor Študentske organizacije Univerze v Mariboru (ŠOUM) - Drago (1970-)</clue><clue word="17" number="35" citation="vpis">glasbena zvrst in element hip-hop kulture, kjer izvajalec ritmično govori ali poje besedila ob ritmični spremljavi, pogosto z uličnim žargonom ali družbeno-kritično vsebino</clue><clue word="18" number="36" citation="vpis">najmanjši izmed šestih glavnih naseljenih otokov Havajev in je poznan kot »otok ananasov« ter »poslednji pravi raj« na havajskem otočju</clue><clue word="19" number="37" citation="vpis">psevdonim švicarsko-francoskega pisatelja Jeana Schopferja - Claude (1868†1931), (Ariana)</clue><clue word="20" number="38" citation="vpis">ruska juha iz govejega ali svinjskega mesa, zelenjave in rdeče pese (gastr.)</clue><clue word="21" number="41" citation="perplexity">vzdevek dubrovniškega boema, šaljivca in intelektualca Milana Milišića (1941†1991)</clue><clue word="22" number="42" citation="vpis">pravni primer (jur.)</clue><clue word="23" number="44" citation="vpis">vrh v Karavankah, ki se nahaja na meji med Slovenijo in Avstrijo. (2029 m)</clue><clue word="24" number="45" citation="vpis">priljubljen sadni namaz, ki ga pogosto zamenjujemo z marmelado, vendar se od nje razlikuje po sestavi in načinu priprave</clue><clue word="25" number="46" citation="vpis">nekdanja slovenska punk rock skupina iz Ljubljane (dve besedi)</clue><clue word="26" number="50" citation="vpis">glavno mesto istoimenske province na jugozahodu Turčije, ki leži v rodovitni dolini reke Büyük Menderes (antični Meander)</clue><clue word="27" number="51" citation="vpis">slovesna, formalna plesna prireditev</clue><clue word="28" number="52" citation="vpis">najvišja gora na Filipinih, ki velja za sveto goro in priljubljeno pohodniško točko</clue><clue word="29" number="55" citation="vpis">tropska rastlina, ki se uporablja kot zelenjava, bamija</clue><clue word="30" number="57" citation="perplexity">danski operni pevec, baritonist - Leif (1931†2003)</clue><clue word="31" number="59" citation="vpis">vrsta energetsko neodvisnega računalniškega pomnilnika, ki omogoča spreminjanje shranjenih podatkov z električnimi impulzi, vendar le v omejenih in specifičnih delih vezja</clue><clue word="32" number="61" citation="vpis">prakanton v Švici z glavnim mestom Altdorf</clue><clue word="33" number="62" citation="vpis">sistem institucij, ki v imenu države ali lokalnih skupnosti izvajajo javne naloge, skrbijo za izvajanje zakonov in zagotavljajo storitve državljanom (dve besedi)</clue><clue word="34" number="64" citation="vpis">grm z majhnimi cvetovi v latih in listi, ki se jeseni obarvajo (bot.)</clue><clue word="35" number="65" citation="vpis">švedska ig