rd id="92" x="3" y="14-17" solution="HERS"/><word id="93" x="8" y="15-17" solution="KIA"/><word id="94" x="12" y="15-17" solution="KUN"/><word id="95" x="2-9" y="11-11" keyword="true" solution="IVIZIJON"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">kraj ali prostor, kjer tekočina (voda, gorivo, zrak) ali snov vteka v večjo celoto</clue><clue word="2" number="5" citation="vpis">tropski kuščar, ki spreminja barvo telesa, zlasti samec v času parjenja</clue><clue word="3" number="10" citation="vpis">(v grški mitologiji) argoški kralj, vodja slovitega pohoda Sedmerice proti Tebam, Adrastus</clue><clue word="4" number="16" citation="vpis">glavno mesto Latvije</clue><clue word="5" number="17" citation="vpis">slikovit polotok in mestna četrt v Dubrovniku, znana po najlepših plažah in sprehajališčih, Hrvaška</clue><clue word="6" number="18" citation="vpis">kolesarska dirka po Španiji (pog.)</clue><clue word="7" number="19" citation="vpis">zdravilo proti vročini in glavobolu (farm.)</clue><clue word="8" number="21" citation="vpis">britanski kralj, ki je združil Anglijo pod eno krono (kralj Wessexa)  (775†839)</clue><clue word="9" number="22" citation="vpis">nemški slikar in grafik - Emil (1867†1956)</clue><clue word="10" number="23" citation="vpis">oseba kot literarna ali dramska upodobitev v zgodbi, igri ali romanu</clue><clue word="11" number="24" citation="vpis">(v hindujski mitologiji) božanski modrec, glasnik bogov in potujoči glasbenik z instrumentalno vinarjo</clue><clue word="12" number="25" citation="vpis">dejanje, proces ali sposobnost ustvarjanja nečesa novega, izvirnega in dragocenega (knjiž.)</clue><clue word="13" number="29" citation="vpis">nemška plesalka in koreografinja - Birgit (1944-)</clue><clue word="14" number="30" citation="vpis">naselje ob glavni cesti Kočevje–Delnice (Hrvaška), tik pred mejnim prehodom Petrina</clue><clue word="15" number="31" citation="vpis">eno od petih Velikih jezer v Severni Ameriki</clue><clue word="16" number="32" citation="vpis">majhen sesalec, ki živi v jamah pod zemljo in kopa rove z lopatastimi sprednjimi tačkami</clue><clue word="17" number="35" citation="vpis">dolga, močna palica (običajno lesena ali kovinska), ki povezuje voz ali kmetijski priključek z vprežno živino ali traktorjem</clue><clue word="18" number="36" citation="vpis">manjša, naravna ali umetno urejena kotanja na Krasu, v kateri se zbira deževnica</clue><clue word="19" number="37" citation="vpis">umetno pridobljen radioaktivni element z višjim atomskim številom kot uran (kem.)</clue><clue word="20" number="39" citation="vpis">prebivalec antične Aonije (del Beotije v Grčiji)</clue><clue word="21" number="40" citation="vpis">dolg, ozek in tanek kos materiala, kot je blago, guma, kovina ali drug material</clue><clue word="22" number="41" citation="vpis">slovenski teolog, filozof, nabožni pisatelj in frančiškan - Gvido (1880†1956)</clue><clue word="23" number="42" citation="vpis">tehnološki postopek, pri katerem s pomočjo električnega toka na model nanesemo plast kovine, da ustvarimo samostojen kovinski predmet</clue><clue word="24" number="47" citation="vpis">največja sladkovodna želva v Južni Ameriki, arrau (zool.)</clue><clue word="25" number="48" citation="vpis">glavno in edino mesto otoške države Samoa v Tihem oceanu</clue><clue word="26" number="49" citation="vpis">kratica za Tovarno avtomobilov Sarajevo</clue><clue word="27" number="50" citation="vpis">enota v artileriji, sestavljena iz dveh do štirih baterij (voj.)</clue><clue word="28" number="53" citation="vpis">ime japonskega teniškega igralca Nišikorija (1989-)</clue><clue word="29" number="54" citation="vpis">del Aleutskega otočja, ki leži v severnem Pacifiku med Aljasko (ZDA) in Rusijo</clue><clue word="30" number="57" citation="vpis">znamka čeških motorjev za speedway</clue><clue word="31" number="58" citation="vpis">somalski politik, dvakratni premier in predsednik - Mohamed Ibrahim (1928†2002)</clue><clue word="32" number="59" citation="vpis">standardna tričrkovna kratica za asparagin, eno izmed 20 osnovnih aminokislin, ki sestavljajo beljakovine v človeškem telesu</clue><clue word="33" number="60" citation="vpis">papež (pog.)</clue><clue word="34" number="61" citation="vpis">obsesivna potreba po brezhibnosti, kjer je vsaka napaka dojeta kot osebni poraz (knjiž.)</clue><clue word="35" number="64" citation="vpis"> judovsko-srbski založnik, pisatelj in družbeni aktivist - Pavle (1898†1941)</clue><clue word="36" number="67" citation="vpis">oznaka za nekdanjo italijansko denarno enoto liro</clue><clue word="37" number="68" citation="vpis">ime slovenskega politika, pisatelja in dramatika, ključna figura socialdemokracije Kristana (1867†1953)</clue><clue word="38" number="69" citation="vpis">del naprave ali ročno orodje za odstranjevanje nečistoč ali ločevanje semen</clue><clue word="39" number="70" citation="vpis">postopek, kjer je telo za kratek čas (2–3 minute) izpostavljeno ekstremno nizkim temperaturam (tudi do -140 °C) za zmanjšanje vnetij in hitrejšo regeneracijo mišic</clue><clue word="40" number="72" citation="vpis">(v hinduizmu) eden najstarejših vedskih bogov, bog voda, oceanov in zahoda</clue><clue word="41" number="73" citation="vpis">japonski proizvajalec avtomobilov, ki je v svetovnem merilu najbolj znan po svojih trpežnih dizelskih motorjih, tovornjakih in poltovornjakih (pick-up)</clue><clue word="42" number="74" citation="vpis">literarna oseba slovenskega pisatelja J. Trdine, divji junak ali velikan, ki pooseblja prvobitno moč narave in Gorjancev</clue><clue word="43" number="75" citation="vpis">iraški šiitski voditelj - Muqtada (1974-)</clue><clue word="44" number="76" citation="vpis">(v hinduizmu) notranji jaz, bit ali duša posameznika</clue><clue word="45" number="77" citation="vpis">vzdevek nemške pevke Gabriele Susanne Kerner (1960-)</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="46" number="1" citation="vpis">gručasto naselje na zahodnem robu Celjske kotline</clue><clue word="47" number="2" citation="vpis">grški pesnik in glasbenik iz Mileta (ok. 450 pr. n. š.†ok. 357 pr. n. š.)</clue><clue word="48" number="3" citation="vpis">avstralski režiser - George (1931†2020), (Pobesneli Max 3)</clue><clue word="49" number="4">pokrajina v Kambodži</clue><clue word="50" number="5" citation="vpis">hotel v Bovcu</clue><clue word="51" number="6" citation="vpis">nemško ime za Ziljsko dolino, Avstrija</clue><clue word="52" number="7" citation="vpis">četrti egiptovski vladar 26. dinastije, ki je vladal od 589 pr. n. š.†570 pr. n. š.</clue><clue word="53" number="8" citation="vpis">avstrijski operni pevec, tenorist - Georg (1872†1951)</clue><clue word="54" number="9" citation="vpis">tiskovna agencija nekdanje NDR</clue><clue word="55" number="10" citation="vpis">najjužnejši od sedmih rimskih gričev</clue><clue word="56" number="11" citation="vpis">prekmurski naziv za Dolgo Vas (dve besedi)</clue><clue word="57" number="12" citation="vpis">vsaka od dvanajstih parov kosti, ki skupaj s prsnico in hrbtenico tvorijo prsni koš (anat.)</clue><clue word="58" number="13" citation="vpis">kocka (lat.)</clue><clue word="59" number="14" citation="vpis">sladka snov, ki jo delajo čebele iz nektarja ali mane</clue><clue word="60" number="15" citation="vpis">indijski industrijski gigant</clue><clue word="61" number="20" citation="perplexity">skandinavski drobiž</clue><clue word="62" number="26" citation="vpis">neapeljska kraljica - Prva (1326†1382)</clue><clue word="63" number="27" citation="vpis">slovenski biokemik in sintetični biolog - Roman (1962-)</clue><clue word="64" number="28" citation="vpis">ena najbolj inteligentnih ptic iz družine vranov</clue><clue word="65" number="32" citation="vpis">noga ali del okončine (anat.)</clue><clue word="66" number="33" citation="perplexity">poškodba tkiva zaradi poškodbe ali operacije (med.)</clue><clue word="67" number="34" citation="perplexity">kratica močnega eksploziva</clue><clue word="68" number="36" citation="vpis">obrtno obdelovanje kovin, zlasti železa in jekla, kovaštvo</clue><clue word="69" number="37" citation="vpis">oseba, ki prestaja hudo telesno ali duševno trpljenje, pogosto zaradi bolezni, revščine ali krivic (ekspr.)</clue><clue word="70" number="38" citation="vpis">eden najbolj priljubljenih ameriških pisateljev zgodovinskih romanov - Leon (1924†2003), (Exodus)</clue><clue word="71" number="39" citation="vpis">pakistansko-britanska pesnica - Moniza (1954-)</clue><clue word="72" number="40" citation="vpis">naselje v občini Mengeš, ki leži v osrednji Sloveniji, v bližini Ljubljane</clue><clue word="73" number="42" citation="vpis">španski kubistični slikar in kipar - Juan (1887†1927)</clue><clue word="74" number="43" citation="perplexity">estonski kolesar - Pikkuus (1954-) (nekd.)</clue><clue word="75" number="44" citation="vpis">eno izmed najsvetejših mest šiitskega islama in glavno mesto istoimenske province v osrednjem Iraku, približno 160 km južno od Bagdad</clue><clue word="76" number="45" citation="vpis">(v grški mitologiji) ena od gorgon, hčerka morskih bogov Forkisa in Keta</clue><clue word="77" number="46" citation="vpis">jezero na meji med provincama Jiangsu in Zhejiang, Kitajska</clue><clue word="78" number="47" citation="vpis">ameriški pisatelj, satirik in dramatik - George (1866†1944), (Znanci)</clue><clue word="79" number="51" citation="vpis">obmorska provinca na jugozahodu Nizozemske, ki jo sestavlja skupina otokov, polotokov in del kopnega ob meji z Belgijo</clue><clue word="80" number="52" citation="vpis">oseba, ki redno in z navdušenjem igra videoigre, bodisi na računalniku, konzolah ali mobilnih napravah</clue><clue word="81" number="53" citation="vpis">naravni sladkor z petimi ogljikovimi atomi, ki ga najdemo v lesu, slami, koruznih storžih in drugih rastlinskih materialih (biol.)</clue><clue word="82" number="54" citation="vpis">manjše razloženo naselje v hribovitem svetu zahodno od Trebnjeg