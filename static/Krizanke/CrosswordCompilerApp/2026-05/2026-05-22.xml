"NAOS"/><word id="56" x="11" y="5-7" solution="MRK"/><word id="57" x="4" y="6-12" solution="BOURBON"/><word id="58" x="8" y="6-10" solution="IEPER"/><word id="59" x="14" y="6-9" solution="JENA"/><word id="60" x="15" y="6-9" solution="ARAT"/><word id="61" x="1" y="7-10" solution="ETAT"/><word id="62" x="2" y="7-10" solution="SULU"/><word id="63" x="3" y="7-15" solution="STARTNINA"/><word id="64" x="9" y="8-13" solution="EFENDI"/><word id="65" x="10" y="8-11" solution="REGA"/><word id="66" x="5" y="9-11" solution="MOR"/><word id="67" x="6" y="10-15" solution="AKOLIT"/><word id="68" x="7" y="10-15" solution="GARAŽA"/><word id="69" x="11" y="10-15" solution="ASKEZA"/><word id="70" x="13" y="11-15" solution="AMINI"/><word id="71" x="14" y="11-15" solution="SISCO"/><word id="72" x="15" y="11-15" solution="OSTAN"/><word id="73" x="1" y="12-15" solution="BONO"/><word id="74" x="2" y="12-15" solution="OČIM"/><word id="75" x="8" y="12-15" solution="URAR"/><word id="76" x="12" y="12-15" solution="UTAH"/><word id="77" x="5" y="13-15" solution="KVA"/><word id="78" x="10" y="13-15" solution="NUT"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">glavno mesto indijske zvezne države Nagaland in je bilo leta 1944 prizorišče ene najpomembnejših bitk druge svetovne vojne, ki je neposredno povezana z zgodovino Burme (današnjega Mjanmara)</clue><clue word="2" number="7" citation="vpis">mesto in okraj v provinci Kerman v Iranu, ki je znano po kmetijstvu, predvsem po pridelavi pistacij</clue><clue word="3" number="11" citation="vpis">močna psihedelična droga, ki povzroča spremembe v zaznavanju, razpoloženju in miselnih procesih. Pogosto se imenuje tudi acid.</clue><clue word="4" number="14" citation="vpis">nekdanji turški zlatnik</clue><clue word="5" number="15" citation="vpis">glavno mesto starodavnega Egipta v obdobju Srednjega in Novega kraljestva, locirano na obeh bregovih Nila, danes znano kot Luxor in Karnak</clue><clue word="6" number="16" citation="vpis">angleški glasbenik, skladatelj, producent, vizualni umetnik in aktivist, znan kot pionir ambientalne glasbe in elektronike - Brian (1948-)</clue><clue word="7" number="17" citation="vpis">ime in priimek ameriške igralke (1941-), (Kitajska četrt)</clue><clue word="8" number="19" citation="vpis">(v nordijski mitologiji) bog groma, neba in kmetijstva ter eden najbolj priljubljenih bogov med ljudstvom</clue><clue word="9" number="20" citation="vpis">srednjeveško sodno dokazno sredstvo, kjer so vero v božjo intervencijo uporabljali za ugotavljanje resnice v sporih ali kazenskih postopkih (jur.)</clue><clue word="10" number="21" citation="vpis">(v grški mitologiji)  sin mojstrskega izumitelja Dedala, najbolj znan po svojem tragičnem poletu proti soncu</clue><clue word="11" number="22" citation="vpis">eden izmed najbolj priljubljenih in razširjenih programskih jezikov, ki ga je razvil James Gosling</clue><clue word="12" number="23" citation="perplexity">naselje na otoku Pagu na Hrvaškem, ki leži na severozahodni konici zelo ozkega polotoka</clue><clue word="13" number="24" citation="vpis">nekdanji vrhunski avstrijski alpski smučar, ki je bil specialist za tehnične discipline, predvsem veleslalom - Hans (1958-)</clue><clue word="14" number="26" citation="vpis">legendarni ustanovitelj in prvi kralj Rima, sin boginje Rei Silvije in boga vojne Marsa</clue><clue word="15" number="28" citation="vpis">počasen utrip srca (med.)</clue><clue word="16" number="32" citation="vpis">mednarodna blagovna znamka ameriškega naftnega giganta ExxonMobil</clue><clue word="17" number="35" citation="vpis">vrv ali jermen, s katerim vežejo tovor na voz ali živali v jarmu  (nar.)</clue><clue word="18" number="36" citation="vpis">(v judovski religiji) prehranski zakoni (kašrut), ki določajo, katera hrana je dovoljena in kako mora biti pripravljena</clue><clue word="19" number="37" citation="vpis">kratek ali dolg spodnji del ženskega baletnega kostuma, izdelan iz več plasti finega tila ali tarlatana (tekst.)</clue><clue word="20" number="38" citation="vpis">vojak, ki opravlja inženirska in tehnična dela na terenu (voj.)</clue><clue word="21" number="41" citation="vpis">desni pritok reke Savinje, v katero se izliva v bližini naselja Šmarjeta pri Celju (v občini Celje)</clue><clue word="22" number="42" citation="vpis">zvočni ali drugi signal, ki opozarja na bližajočo se nevarnost ali izredni dogodek, kot so požar, vlom, nesrečo ali drugo ogroženost</clue><clue word="23" number="44" citation="vpis">vrtenje ali rotacija žoge, zaradi katere se njena pot v zraku zakrivi. (šport.)</clue><clue word="24" number="45" citation="vpis">španski proizvajalec avtomobilov, ustanovljen leta 1950, ki je danes del skupine Volkswagen</clue><clue word="25" number="46" citation="vpis">sklop dveh ključnih naprav: parne ali plinske turbine in električnega generatorja, ki sta povezana z isto gredjo (strojn.)</clue><clue word="26" number="50" citation="vpis">mitološko bitje, ki nastopa kot varuhinja svetih dni in kaznovalka tistih, ki kršijo prepoved dela (etn.)</clue><clue word="27" number="51" citation="vpis">vzdevek ameriškega raperja in tekstopisca Nasirja bin Olu Dara Jonesa (1973-)</clue><clue word="28" number="52" citation="vpis">eden največjih aktivnih vulkanov na svetu, ki leži na otoku Kjušu, Japonska (1593 m)</clue><clue word="29" number="55" citation="vpis">mesto v zvezni deželi Severno Porenje-Vestfalija, Nemčija, nekdanje glavno mesto</clue><clue word="30" number="57" citation="vpis">majhen nenaseljen otoček jugozahodno od otoka Drvenik Veli, Hrvaška</clue><clue word="31" number="59" citation="vpis">tradicionalna fermentirana mlečna pijača srednjeazijskih nomadov, narejena iz kobiljega mleka z dodatkom alkohola in gaziranosti zaradi laktobacilov ter kvasovk</clue><clue word="32" number="61" citation="Perplexity">ata, oče (ljubk.)</clue><clue word="33" number="62" citation="vpis">glasbenik, ki igra na klarinet, pihalo z enojnim jezičkom</clue><clue wor