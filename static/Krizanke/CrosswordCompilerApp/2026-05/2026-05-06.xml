e"/><word id="137" x="1" y="18-21" solution="ATOL"/><word id="138" x="2" y="18-21" solution="REPA"/><word id="139" x="3" y="18-21" solution="OLAJ"/><word id="140" x="9" y="18-21" solution="PAPE"/><word id="141" x="14" y="18-21" solution="TLAK"/><word id="142" x="15" y="18-21" solution="RADO"/><word id="143" x="16" y="18-20" solution="ATA"/><word id="144" x="8" y="19-21" solution="ULJ"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">gora v Julijskih Alpah (2410 m), tudi Stenar</clue><clue word="2" number="5" citation="vpis">kdor se poklicno ukvarja z vzrejo ali vodenjem psov</clue><clue word="3" number="9" citation="vpis">v islamu edini Bog, ki je stvarnik, vsemogočen in usmiljen</clue><clue word="4" number="13" citation="vpis">pripadnik starodavnega plemena, ki je naseljevalo dele antične Dacije</clue><clue word="5" number="18" citation="vpis">tradicionalna indijska pijača na osnovi jogurta</clue><clue word="6" number="19" citation="vpis">atraktivni premet telesa v zraku za 360 stopinj, ne da bi se z rokami dotaknili tal (šport.)</clue><clue word="7" number="20" citation="vpis">tradicionalno rusko poimenovanje za sezonsko ali počitniško hišo na podeželju</clue><clue word="8" number="21" citation="vpis">ime nekaterih butičnih vinskih linij v Italiji, ki rastejo na apnenčastih tleh, bogatih z minerali</clue><clue word="9" number="22" citation="vpis">krajša, pogovorna oblika za prebivalca Amerike (ZDA)</clue><clue word="10" number="23" citation="vpis">ameriški matematik in računalniški strokovnjak - Donald Ervin (1938-)</clue><clue word="11" number="24" citation="perplexity">pripadnik nomadskega ljudstva turškega izvora, Ober</clue><clue word="12" number="25" citation="vpis">nekdanji vojak redne vojske, domačin v službi kolonialnih sil (nekdaj)</clue><clue word="13" number="26" citation="vpis">sorta paprike (t.i. paradižnikova paprika), ki ima ploščato okroglo in mesnato obliko, podobno paradižniku</clue><clue word="14" number="29" citation="vpis">41. zvezna država ZDA, ki leži na severozahodu države ob meji s Kanado z glavnim mestom Helena</clue><clue word="15" number="31" citation="vpis">irski politik, nekdanji ministrski predsednik - Bertolemew, "Bertie" (1951-)</clue><clue word="16" number="32" citation="vpis">dokončno prenehanje življenjskih procesov v organizmu</clue><clue word="17" number="33" citation="vpis">ptica z močnim dletastim kljunom in nogami za plezanje po deblu</clue><clue word="18" number="34" citation="vpis">(v rimski mitologiji) boginja svetlobe, lova in narave</clue><clue word="19" number="38" citation="vpis">skrivnostna srednjeveška sekta šiitskih izmaelcev, ki je delovala med 11. in 13. stoletjem na območju današnjega Irana in Sirije</clue><clue word="20" number="40" citation="vpis">določena oblika socvetja (npr. pri travah, ovesu ali rižu), kjer se glavna os večkrat razveji, na koncih vejic pa so cvetovi ali klaski (bot.)</clue><clue word="21" number="44">praznik Marijinega rojstva 8. septembra (rel.), (dve besedi)</clue><clue word="22" number="48" citation="vpis">ugandski general in diktator - Idi Dada (1925†2003)</clue><clue word="23" number="49" citation="vpis">legendarni britanski kralj, ki želi razdeliti svoje kraljestvo med tri hčere na podlagi tega, katera ga ima najbolj rada</clue><clue word="24" number="50" citation="vpis">ime italijanskega pisatelja Ojettija (1871†1946)</clue><clue word="25" number="51" citation="vpis">najvišji slap v Sloveniji, ki pa je danes le še senca svoje nekdanje podobe zaradi obsežnega podora (130 m)</clue><clue word="26" number="52" citation="vpis">umetno usnje oziroma nepravo usnje, ki je videti kot pravo usnje, vendar je narejeno iz sintetičnih materialov</clue><clue word="27" number="53" citation="vpis">največje mesto v jugozahodni Etiopiji in zgodovinsko središče regije, ki velja za enega od izvornih domov kave arabika</clue><clue word="28" number="54" citation="vpis">prizorišče snemanja ali prostor, kjer stoji scena (film.)</clue><clue word="29" number="55" citation="vpis">največja in hkrati najredkeje poseljena provinca Kameruna, njeno upravno središče je mesto Bertoua</clue><clue word="30" number="56" citation="vpis">slika, ki je sestavljena iz mreže posameznih barvnih točk, imenovanih piksli (slikovne pike) v grafiki in tehnologiji</clue><clue word="31" number="59" citation="vpis">krajši pisni sestavek, namenjen objavi v časopisu, reviji ali na spletu, ki podaja informacije ali razpravo o določenem dogodku, problemu ali temi</clue><clue word="32" number="61" citation="vpis">zgornji zaključni del stavbe, ki ščiti pred vremenskimi vplivi, streha</clue><clue word="33" number="63" citation="vpis">roman rusko-ameriškega pisatelja V. Nabokova</clue><clue word="34" number="65" citation="vpis">strokovni in ljudski izraz za cisticerkozo, okužbo z ličinkami trakulje</clue><clue word="35" number="67" citation="vpis">tehnologija, ki uporablja zvočno valovanje za navigacijo, komunikacijo ter odkrivanje in lociranje predmetov pod vodno gladino</clue><clue word="36" number="70" citation="vpis">majhen sesalec, ki živi v jamah pod zemljo in kopa rove z lopatastimi sprednjimi tačkami</clue><clue word="37" number="71" citation="vpis">italijanski politik nekdanji predsednik vlade - Giuseppe (1964-)</clue><clue word="38" number="72" citation="vpis">pokrajina ob reki Sotli, ki teče ob slovensko-hrvaški meji</clue><clue word="39" number="75" citation="vpis">slovenska književnica, prevajalka in urednica - Neža (1930†2025), (Metulj na snegu)</clue><clue word="40" number="77" citation="perplexity">slovenska umetnostna zgodovinarka - Anica (1926†2011)</clue><clue word="41" number="81" citation="vpis">oseba, ki piše ali poustvarja elegije (žalostinke), oziroma nekdo, ki je po naravi melanholičen in otožen (knjiž.)</clue><clue word="42" number="82" citation="vpis">sorodstvo, družinski člani in širša družinska skupnost (pog.)</clue><clue word="43" number="84" citation="vpis">arabsko ime za Jezusa</clue><clue word="44" number="87" citation="perplexity">jezero na meji med provincama Jiangsu in Zhejiang, Kitajska</clue><clue word="45" number="88" citation="vpis">ime slovenske novinarke in političarke Klinarjeve (1952-)</clue><clue word="46" number="89" citation="vpis">(po Bibliji) prvi sin Adama in Eve, znan predvsem po tem, da je ubil svojega brata Abela, kar je prvi umor v človeški zgodovini po Bibliji</clue><clue word="47" number="90" citation="vpis">vpliven hrvaški politik, ekonomist in univerzitetni profesor, znan po svoji ključni vlogi v obdobju hrvaške pomladi in osamosvajanja Hrvaške - Šime (1927†2007)</clue><clue word="48" number="92" citation="perplexity">zgodovinsko mesto v jugozahodni Nemčiji, ki leži ob reki Donavi v zvezni deželi Baden-Wurttemberg</clue><clue word="49" number="93" citation="vpis">skupek kovinskih elementov, kot so tečaji, sponke, kljuke, vijaki in drugi pritrdilni deli za vrata, okna, pohištvo ali lesene konstrukcije, okovje</clue><clue word="50" number="94" citation="vpis">pomembna italijanska slikarja iz obdobja pozne gotike in zgodnje renesanse (15. stoletje), ki sta delovala v Modeni, brata - Agnolo in Bartolomeo</clue><clue word="51" number="95" citation="vpis">zunanji, vidni del vozila, ki je nameščen na podvozje, okrov (avt.)</clue><clue word="52" number="97" citation="vpis">italijanski diplomat in pisatelj, ki je svetovno slavo dosegel predvsem s svojimi spomini in romani, postavljenimi na Kitajsko - Daniele (1880†1956)</clue><clue word="53" number="98" citation="vpis">priljubljena španska in portugalska osvežilna pijača na osnovi vina in sadja</clue><clue word="54" number="101" citation="vpis">priljubljeno turistično naselje na Hrvaškem, ki se nahaja v neposredni bližini Vodic v Šibeniško-kninski županiji</clue><clue word="55" number="102" citation="vpis">občina (comune) v regiji Furlanija - Julijska krajina v Italiji, blizu meje s Slovenijo, Drenchia</clue><clue word="56" number="104" citation="vpis">zmes peska, apna ali ceme