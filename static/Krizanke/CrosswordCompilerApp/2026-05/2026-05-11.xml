 solution="NIATA"/><word id="90" x="17" y="13-17" solution="STELA"/><word id="91" x="9" y="14-17" solution="PIRO"/><word id="92" x="10" y="14-17" solution="SCAT"/><word id="93" x="14" y="14-17" solution="TODA"/><word id="94" x="6" y="15-17" solution="KIA"/><word id="95" x="7" y="15-17" solution="ATS"/><word id="96" x="8" y="15-17" solution="REN"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">bele, igličaste ledene obloge, ki nastanejo, ko drobne kapljice megla v podhlajenem stanju zadenejo ob hladne predmete (veje, žice, ograje) in takoj zmrznejo (knjiž.)</clue><clue word="2" number="5" citation="vpis">prostor ali opremo za shranjevanje živil in drugih predmetov</clue><clue word="3" number="12" citation="vpis">zelo strupena puščavska kača</clue><clue word="4" number="15" citation="vpis">(v grški mitologiji) Odisejev oče, kralj Itake, Laertes</clue><clue word="5" number="17" citation="vpis">član elektorskega kolidža, ki v imenu svoje zvezne države odda glas za predsednika Združenih držav Amerike</clue><clue word="6" number="18" citation="vpis">posebna nadarjenost ali sposobnost za kaj</clue><clue word="7" number="19" citation="vpis">največji polotok v Jadranskem morju, ki leži na stičišču Slovenije, Hrvaške in Italije</clue><clue word="8" number="20" citation="vpis">stanje, ko nekdo ne kaže zanimanja, pozornosti ali navdušenja do nečesa</clue><clue word="9" number="22" citation="vpis">skrajšana oblika besede ali besedne zveze</clue><clue word="10" number="24" citation="vpis">indonezijsko ime za otok Nova Gvineja oziroma njegov zahodni del (danes provinca Papua)</clue><clue word="11" number="25" citation="vpis">kratica za narodnoosvobodilna vojska (vojna)</clue><clue word="12" number="26" citation="vpis">župnik, ki je skrbnik farne župnije ali vernikov na določenem območju; duhovnik (slabš.)</clue><clue word="13" number="27" citation="vpis">užitna goba s sluzastim rjavim klobukom (bot.)</clue><clue word="14" number="30" citation="vpis">partizansko ime slovenskega pesnika Karela Destovnika (1922†1944)</clue><clue word="15" number="32" citation="vpis">prebivalci Škotske, severnega dela Velike Britanije</clue><clue word="16" number="34" citation="vpis">mesto in regija v severozahodni Savdski Arabiji</clue><clue word="17" number="35" citation="vpis">izraz za osebo brez nadarjenosti ali sposobnosti za določeno dejavnost, pogosto v humornem ali irončnem kontekstu (pog.)</clue><clue word="18" number="38" citation="vpis">upokojena legenda ameriške košarke, ki velja za enega najboljših igralcev vseh časov - Larry Joe (1956-)</clue><clue word="19" number="41" citation="vpis">tanko vlakno, uporabljeno za šivanje, vezenje ali pletenje, pogosto iz bombaža, svile ali sintetičnih materialov</clue><clue word="20" number="42" citation="vpis">naselje v Mestni občini Velenje, ki leži v hribovitem obrobju Šaleške doline</clue><clue word="21" number="47" citation="vpis">zdravnik specialist, ki se ukvarja z diagnozo in zdravljenjem bolezni ušes, nosu in grla</clue><clue word="22" number="52" citation="vpis">zadebeljen del rastline, ki služi kot skladišče hranilnih snovi in vode, kar rastlini omogoča preživetje neugodnih obdobij ali nespolno razmnoževanje</clue><clue word="23" number="53" citation="vpis">nitast izrastek iz roževine, ki raste iz kože na človeški glavi</clue><clue word="24" number="54" citation="vpis">prostor za shranjevanje predmetov, ki niso v neposredni uporabi ali razstavi</clue><clue word="25" number="55" citation="vpis">slovenski košarkarski trener - Sašo (1974-)</clue><clue word="26" number="60" citation="vpis">hrvaški skladatelj in pedagog - Krsto (1888†1965), (Zorica pleše)</clue><clue word="27" number="64" citation="vpis">argentinski teniški igralec - Guillermo (1952-) (nekd.)</clue><clue word="28" number="65" citation="vpis">britanski politik, ki je bil med letoma 1990 in 1997 predsednik vlade Združenega kraljestva in vodja Konservativne stranke - John (1943-)</clue><clue word="29" number="68" citation="vpis">razloženo naselje v Občini Slovenska Bistrica, ki leži na jugovzhodnem delu Pohorja</clue><clue word="30" number="70" citation="vpis">reka na Poljskem, desni pritok reke Warte, ki je ena od glavnih rek zahodne Poljske</clue><clue word="31" number="71" citation="vpis">latinsko ime za rod pravih prašičev, ki spada v družino pravih prašičev</clue><clue word="32" number="73" citation="vpis">britanski glasbenik, violončelist - Rohan de (1939-)</clue><clue word="33" number="74" citation="vpis">strokovno sestavljen instrument za merjenje psihičnih lastnosti, sposobnosti ali osebnostnih značilnosti (med.)</clue><clue word="34" number="77" citation="vpis">oseba, ki je usposobljena za pripravo, izdajo in svetovanje o zdravilih ter drugih farmacevtskih izdelkih v lekarni</clue><clue word="35" number="81" citation="vpis">skupno ime za rastline iz družine ločkovk, ki rastejo na vlažnih tleh, ob močvirjih, jarkih in bregovih voda</clue><clue word="36" number="82">kitajsko ameriška pisateljica - Gish (1955-)</clue><clue word="37" number="83" citation="vpis">človek, ki se ukvarja z literaturo, najpogosteje kot književnik ali pisatelj (ekspr.)</clue><clue word="38" number="84" citation="vpis">oseba, ki jo nekdo občuduje in ji želi biti podoben</clue><clue word="39" number="85" citation="vpis">melodični okrasek, ki je sestavljen iz več hitrih zaporednih tonov, ki se igrajo pred glavno noto (muz.)</clue><clue word="40" number="86" citation="vpis">lastnost tistega, kar je jasno, razumljivo ali razvidno (star.)</clue><clue word="41" number="87" citation="vpis">bolezen kože, ki se kaže z različnimi spremembami – predvsem v obliki mozoljev, papul, pustul, komedonov (ogrcev) in v hujših primerih tudi cist ali nodul (med.)</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="42" number="1" citation="vpis">antično ime za Trojo, znamenito mesto v Mali Aziji (današnja Turčija), ki ga poznamo iz Homerjeve Iliade</clue><clue word="43" number="2" citation="vpis">silovit, nenaden in hitro izveden napad na nasprotnika ali utrdbo</clue><clue word="44" number="3" citation="vpis">žena moževega brata, svakinja ali svakova ženo (zastar.)</clue><clue word="45" number="4" citation="vpis">babilonski in akadski bog vojne, kuge in uničenja</clue><clue word="46" number="5" citation="vpis">antični verz, ki je sestavljen iz šestih stopic (običajno jambskih) (lit.)</clue><clue word="47" number="6" citation="vpis">stavba ali prostor za bivanje domačih živali, zlasti večjih, kot so govedo, konji ali svinje</clue><clue word="48" number="7" citation="vpis">kovinski del, ki služi za zapiranje ali zaklepanje vrat, oken ali pokrovov</clue><clue word="49" number="8" citation="vpis">starodavno pristanišče v Izraelu, Akko, Acca, Akka, Akon</clue><clue word="50" number="9" citation="perplexity">uradna okrajšava za Mavretanijo</clue><clue word="51" number="10" citation="vpis">slavni italijanski šahovski mojster iz 16. stoletja, ki je veljal za enega najboljših igralcev svoje dobe - Paolo (1528†1598)</clue><clue word="52" number="11" citation="vpis">starodavni astronomski instrument, ki meri položaj nebesnih teles glede na ekliptiko in ravnino neba</clue><clue word="53" number="12" citation="vpis">slovnični pojem, ki označuje število samostalnika, glagola ali druge besede, ko govorimo o enem samem predmetu, osebi ali pojmu (lingv.)</clue><clue word="54" number="13" citation="vpis">(po Homerju) izmišljeno ljudstvo, ki naj bi živelo na otoku Faetija, kamor je naplavilo Odiseja</clue><clue word="55" number="14" citation="vpis">eden najbolj aktivnih vulkanov na svetu (čeprav trenutno počiva) in glavna turistična znamenitost Kostarike (1670 m)</clue><clue word="56" number="16" citation="vpis">močan tropski ciklon, ki nastane nad severozahodnim delom Tihega oceana</clue><clue word="57" number="21" citation="vpis">turistični in izletniški kraj na Pohorju s prostranimi smučišči, ki je s cesto povezan z Mariborom in Rušami</clue><clue word="58" number="23" citation="vpis">vertikalni ali nagnjen rov, ki povezuje površje s podzemnimi deli rudnika za prevoz rudarjev, rude ali prezračevanjerudniški jašek (žarg.)</clue><clue word="59" number="27" citation="vpis">eden izmed dveh osnovnih načinov (tonovskih načinov) v zahodni glasbi (muz.)</clue><clue word="60" number="28" citation="vpis">(v grški mitologiji) Zevsova hči, boginja zaslepljenosti, nepremišljenosti, bloda in pogube</clue><clue word="61" number="29" citation="vpis">največji arhitekt in gradbenik Osmanskega cesarstva - Mimar (1489 †1588 )</clue><clue word="62" number="31" citation="vpis">trpežna ploskev (platno ali sintetična tkanina), razpeta na jamboru, ki izkorišča moč vetra za pogon plovila</clue><clue word="63" number="32" citation="vpis">lesen ali plastičen del ročnega orodja, ki omogoča oprijem (pog.)</clue><clue word="64" number="33" citation="vpis">rod okrasnih listavcev iz družine trobljevcov, ki so v Sloveniji zelo priljubljeni v parkih in na domačih vrtovih (vrtn.)</clue><clue word="65" number="36" citation="perplexity">(v grški mitologiji) tebanska princesa, hči Kadmosa in Harmonije, Leukotea</clue><clue word="66" number="37" citation="vpis">odprto javno mesto v mestu ali naselju, kjer se običajno zbirajo ljudje, potekajo tržnice, prireditve ali družabni dogodki</clue><clue word="67" number="38" citation="vpis">(v monoteizmu) edino, vrhovno, nadnaravno bitje, stvarnik in vzdrževalec vesolja</clue><clue word="68" number="39" citation="vpis">eden najvplivnejših državnikov v japonski zgodovini in ključna osebnost obdobja Meidži, prvi japonski premier - Hirobumi (1841†1909)</clue><clue word="69" number="40" citation="vpis">uradno, spoštljivo in politično korektno ime za pripadnika romskega naroda</clue><clue word="70" number="43" citation="vpis">mesto na steblu rastline, kjer izrašča list, veja ali brst (bot.)</clue><clue word="71" number="44" citation="vpis">pivo zgornjega vretja, kar pomeni, da kvasovke fermentirajo pri višjih temperaturah (običajno med 15 in 24 °C) na površini tekočine</clue><clue word="72" number="45" citation="vpis">slovenski jezikoslovec, zgodovinar in kritik - Matija (1797†1835)</clue><clue word="73" number="46" citation="vpis">jaz, kot zavest o sebi oziroma samopodoba posameznika (filoz.)</clue><clue word="74" number="48" citation="vpis">psevdonim ruskega pisatelja Ilje Fajnzilberga - Ilja Arnoldovič (1897†1937)</clue><clue word="75" number="49" citation="vpis">omejen kos sveta, namenjen kmetijski obdelavi in pridelavi kulturnih rastlin (poljščin)</clue><clue word="76" number="50" citation="vpis">eden najbolj plodovitih in priljubljenih hrvaških književnikov 20. stoletja - Ivan (1921†1987), (Plavi Jadran)</clue><clue word="77" number="51" citation="vpis">uradna okrajšava za Deviške otoke</clue><clue word="78" number="56" citation="vpis">pripomoček s široko odprtino na vrhu in cevko spodaj, ki služi za prelivanje tekočin v posode z ozkim grlom, lijak (knjiž.)</clue><clue word="79" number="57" citation="vpis">reka v srednji Nemčiji, levi pritok Saale</clue><clue word="80" number="58" citation="vpis">naraven telesni odziv na zabavne, vesele ali nesmiselne dražljaje</clue><clue word="81" number="59" citation="vpis">eden najbolj prepoznavnih slovenskih radijskih voditeljev in glasbenih urednikov, ki že desetletja soustvarja podobo drugega programa Radia Slovenija – Vala 202 - Andrej (1970-)</clue><clue word="82" number="60" citation="vpis">nogometno pravilo, ki določa, kdaj je igralec napadalske ekipe v prepovedanem položaju glede na nasprotnikove igralce (šport.)</clue><clue word="83" number="61" citation="vpis">ameriški pevec gospelov in zborovodja - O’landa (1964†1998)</clue><clue word="84" number="62" citation="vpis">ameriški pesnik in pistaelj - Edward S. (1916†1975)</clue><clue word="85" number="63" citation="vpis">denarna enota v Mjanmarju</clue><clue word="86" number="66" citation="vpis">veja ali tanjše deblo, ki so mu osekali (oklestili) stranske vejice, oklešček (nar.)</clue><clue word="87" number="67" citation="vpis">pionir slovenskega in svetovnega letalstva, pogosto imenovan "slovenski Ikar" - Edvard (1886†1911)</clue><clue word="88" number="69" citation="vpis">večletna rastlina vzpenjalka iz družine konopljevk, ki je v Sloveniji izjemno pomembna kmetijska kultura, predvsem zaradi pridelave piva (agr.)</clue><clue word="89" number="70" citation="vpis">manjše naselje v Lakoniji na Peloponezu (Grčija)</clue><clue word="90" number="72" citation="vpis">pokončen kamen ali kamnita plošča, običajno z napisi ali reliefi</clue><clue word="91" number="74" citation="vpis">italijanska igralka - Imma (1956-), (Corleone)</clue><clue word="92" number="75" citation="vpis">vokalna improvizacija v džezu (jazz), kjer pevec namesto besed uporablja nesmiselne zloge</clue><clue word="93" number="76" citation="vpis">japonska igralka - Keiko (1957-)</clue><clue word="94" number="78" citation="vpis">južnokorejski proizvajalec avtomobilov</clue><clue word="95" number="79" citation="perplexity">švicarska tiskovna agencija</clue><clue word="96" number="80" citation="vpis">ena najpomembnejših evropskih rek, ki izvira v švicarskih Alpah (kanton Graubunden) in teče skozi več držav</clue></clues></crossword></rectangular-puzzle></crossword-compiler-applet>
