s1:word id="66" x="6" y="10-12" solution="ILI" /><ns1:word id="67" x="13" y="10-15" solution="ANONIM" /><ns1:word id="68" x="14" y="10-15" solution="LONDŽA" /><ns1:word id="69" x="15" y="10-15" solution="AVATAR" /><ns1:word id="70" x="7" y="11-15" solution="UKRAS" /><ns1:word id="71" x="12" y="11-15" solution="AMARO" /><ns1:word id="72" x="8" y="12-15" solution="VEŽA" /><ns1:word id="73" x="9" y="12-15" solution="AMBA" /><ns1:word id="74" x="1" y="13-15" solution="DKW" /><ns1:word id="75" x="2" y="13-15" solution="ROA" /><ns1:word id="76" x="3" y="13-15" solution="ERL" /><ns1:word id="77" x="4" y="13-15" solution="DAD" /><ns1:word id="78" x="10" y="13-15" solution="BER" /><ns1:clues ordering="normal"><ns1:title><ns1:b>Vodoravno</ns1:b></ns1:title><ns1:clue word="1" number="1" citation="vpis">šesto največje mesto na Madžarskem in izjemno pomembno gospodarsko, kulturno ter univerzitetno središče</ns1:clue><ns1:clue word="2" number="5" citation="vpis">rastlina iz družine nebinovk, ki je znana po svojih trnovih listih in cvetovih, podobnih bodicam</ns1:clue><ns1:clue word="3" number="9" citation="vpis">religiozna in lirična pesem, namenjena slavljenju Boga, molitvi ali premišljevanju (rel.)</ns1:clue><ns1:clue word="4" number="14" citation="vpis">manjša, podolgovata površinska poškodba, praska ali zareza na gladki površini</ns1:clue><ns1:clue word="5" number="15" citation="vpis"> ameriška komičarka, igralka in pevka, ki velja za eno od pionirk televizijske komedije - Imogene (1908†2001), (Prigode na počitnicah)</ns1:clue><ns1:clue word="6" number="16" citation="vpis">kraljica italijanskega cirkusa, priljubljena igralka in kultna medijska osebnost – Moira (1931†2015)</ns1:clue><ns1:clue word="7" number="17" citation="vpis">trdi sir iz surovega kravjega mleka, ki ga odlikujeta blag, rahlo oreškast okus in značilna rumena barva (gastr.)</ns1:clue><ns1:clue word="8" number="19" citation="vpis">prodajna stojnica, pult ali lopa na odprtem prostoru, predvsem na tržnicah, sejmih, kmečkih tržnicah ali prazničnih prireditvah (pog.)</ns1:clue><ns1:clue word="9" number="20" citation="vpis">irski skladatelj, dirigent in operni pevec, baritonist - Michael William (1808†1870)</ns1:clue><ns1:clue word="10" number="21" citation="vpis">snov, ki vpliva na osrednji živčni sistem in spreminja psihično stanje, zaznavanje, počutje ali vedenje</ns1:clue><ns1:clue word="11" number="23" citation="vpis">elektronska navigacijska in merilna naprava, ki s pomočjo zvočnih valov meri globino vode ter zaznava predmete pod vodno gladino (navt.)</ns1:clue><ns1:clue word="12" number="25" citation="vpis">neprijetno čustveno stanje vznemirjenosti, napetosti, negotovosti in nedoločenega strahu</ns1:clue><ns1:clue word="13" number="30" citation="vpis">nadzemni del repe, krompirja ali korenja – torej listje ali zeleni vrh rastline, ki rasti nad tlemi (nar.)</ns1:clue><ns1:clue word="14" number="31" citation="vpis">glavno in največje mesto Latvije ter največja metropola v vseh treh baltskih državah</ns1:clue><ns1:clue word="15" number="34" citation="vpis">strokovnjak za ugotavljanje nosilnosti in stabilnosti gradbenih konstrukcij</ns1:clue><ns1:clue word="16" number="35" citation="vpis">klasičen dvobarvni tekstilni vzorec, sestavljen iz drobnih, prepletenih dvobarvnih kvadratkov (najpogosteje v črno-beli kombinaciji)</ns1:clue><ns1:clue word="17" number="37" citation="vpis">pogovorni izraz za mladega fanta ali mladeniča, pogosto z rahlim ljubkovalnim prizvokom</ns1:clue><ns1:clue word="18" number="38" citation="vpis">kirurški poseg presajanja ali rekonstrukcije kože (med.)</ns1:clue><ns1:clue word="19" number="42" citation="perplexity">naravno celulozno vlakno, ki se uporablja za izdelovanje vrečevine</ns1:clue><ns1:clue word="20" number="43" citation="vpis">začetni udarec oziroma začetno podajo, s katero se žoga ali pernati polžek spravi v igro (šport.)</ns1:clue><ns1:clue word="21" number="44" citation="vpis">judovski nagovor boga v molitvi (moj gospod), (orig.)</ns1:clue><ns1:clue word="22" number="47" citation="vpis">organska kemijska spojina, ki jo najdemo v listih čajevca</ns1:clue><ns1:clue word="23" number="48" citation="vpis">krilo rimske konjenice</ns1:clue><ns1:clue word="24" number="51" citation="vpis">osma najvišja gora na svetu, ki se dviga 8.163 metrov nad morsko gladino</ns1:clue><ns1:clue word="25" number="53" citation="vpis">vpliven sovjetski politik, tesen sodelavec in desna roka Josipa Stalina - Andrej Aleksandrovič (1896†1948)</ns1:clue><ns1:clue word="26" number="55" citation="vpis">buča (nar.)</ns1:clue><ns1:clue word="27" number="58" citation="vpis">rimska naselbina, ki je stala na območju današnje Ljubljane</ns1:clue><ns1:clue word="28" number="59" citation="vpis">pričeska, kjer so lasje zaviti v vrvi podobne pramene</ns1:clue><ns1:clue word="29" number="63" citation="vpis">nizozemski slikar in grafik - Harmenszoon van Rijn (1606†1669)</ns1:clue><ns1:clue word="30" number="65" citation="vpis">gora in gorski masiv na jugozahodu Balkanskega polotoka, ki leži na meji med Albanijo in Severno Makedonijo</ns1:clue><ns1:clue word="31" number="66" citation="vpis">slovenski slikar in likovni pedagog - Anton (1862†1905)</ns1:clue><ns1:clue word="32" number="67" citation="vpis">lesena drča ali korita, ki so ga gozdarji v preteklosti uporabljali za spravilo posekanega lesa iz strmih, težko dostopnih gorskih gozdov v dolino</ns1:clue><ns1:clue word="33" number="68" citation="vpis">ameriška igralka - Janet (1920†2016) (Družina Adams)</ns1:clue><ns1:clue word="34" number="69" citation="vpis">desni pritok reke Mozele, Nemčija</ns1:clue><ns1:clue word="35" number="70" citation="vpis">vrhovni verski voditelj talibanov v Afganistanu - Mula Mohamed (1959-)</ns1:clue></ns1:clues><ns1:clues ordering="normal"><ns1:title><ns1:b>Navpično</ns1:b></ns1:title><ns1:clue word="36" number="1" citation="vpis">podolgovat, ozek in izrazit zgornji del gorske verige ali hrbta, kjer se stikata dve nasprotni pobočji</ns1:clue><ns1:clue word="37" number="2" citation="vpis">svetovno znan japonski večnacionalni konglomerat z izjemno pestro zgodovino, ki ga ljudje povezujejo predvsem z dvema vrhunskima področjema: glasbo in motornimi vozili</ns1:clue><ns1:clue word="38" number="3" citation="vpis">srednje velika divja mačka, ki poseljuje tropske deževne gozdove, mangrove in savane Srednje ter Južne Amerike (zool.)</ns1:clue><ns1:clue word="39" number="4" citation="vpis">slovenski filmski režiser in scenarist - Rajko (1937†2017), (Ko zorijo jagode)</ns1:clue><ns1:clue word="40" number="5" citation="vpis">reka na severu Španije, ki teče skozi provinco Biscay v avtonomni skupnosti Baskija</ns1:clue><ns1:clue word="41" number="6" citation="vpis">denarna enota in kovanec, ki je skozi stoletja močno zaznamoval evropski denarni sistem (nekdaj)</ns1:clue><ns1:clue word="42" number="7" citation="vpis">strokovno ime za rod javorjev</ns1:clue><ns1:clue word="43" number="8" citation="vpis">vedeževalske karte, razdeljene na velike arkane (22 kart) in male arkane (56 kart), uporabljene za napovedovanje ali duhovno razmišljanje</ns1:clue><ns1:clue word="44" number="9" citation="vpis">nečloveško, grozljivo bitje ali metafora za nekaj, kar pooseblja strah in grozo</ns1:clue><ns1:clue word="45" number="10" citation="vpis">viličasta ribja koščica (zool.)</ns1:clue><ns1:clue word="46" number="11" citation="vpis">naselje in občina na francoskem otoku Korzika, v departmaju Corse-du-Sud</ns1:clue><ns1:clue word="47" number="12" citation="vpis">ukrajinsko-ameriški košarkar - Oleksij Jurjevič (1993-)</ns1:clue><ns1:clue word="48" number="13" citation="vpis">pripoved ali zgodba, ki pojasnjuje naravne pojave, izvor sveta, bogove, junake in običaje v okviru določene kulture ali religije</ns1:clue><ns1:clue word="49" number="18" citation="vpis">matematična ali logična trditev, ki ni samoumevna, ampak jo je mogoče in jo je treba matematično dokazati na podlagi že sprejetih predpostavk (aksiomov) in predhodno dokazanih izrekov (knjiž.)</ns1:clue><ns1:clue word="50" number="22" citation="vpis">za polton znižani ton g (muz.)</ns1:clue><ns1:clue word="51" number="24" citation="vpis">model avtomobila italijanskega proizvajalca Fiat</ns1:clue><ns1:clue word="52" number="26" citation="vpis">besedilo, sestavljeno iz črk, številk ali simbolov, ki je z določenim namenom vrezano, vklesano, naslikano, natisnjeno ali kako drugače pritrjeno na določeno površino</ns1:clue><ns1:clue word="53" number="27" citation="vpis">kopnena površina, ki je z vseh strani obdana z vodo, bodisi z morjem, jezerom, reko ali drugim vodnim telesom</ns1:clue><ns1:clue word="54" number="28" citation="vpis">ljubkovalni izraz za gosenico, črva ali katero koli drobno, plazečo se žuželko (otr.)</ns1:clue><ns1:clue word="55" number="29" citation="vpis">starodavno pristanišče v Izraelu, Akko, Acca, Akka, Akon</ns1:clue><ns1:clue word="56" number="32" citation="vpis">mineralni prah (kalcijev sulfat dihidrat) ali njegova mešanica z vodo za ometavanje, oblikovanje ali imobilizacijo pri zlomih, mavec (pog.)</ns1:clue><ns1:clue word="57" number="33" citation="vpis">oseba, ki jo odlikujejo izjemna telesna moč, vzdržljivost, gibčnost in skladna, mišičasta postava</ns1:clue><ns1:clue word="58" number="35" citation="vpis">(v indijski filozofiji) univerzalna življenjska energija ali vitalna sila, ki prežema vse vesolje in oživlja vsa živa bitja</ns1:clue><ns1:clue word="59" number="36" citation="vpis">najdaljša reka v Švici, levi pritok Rena, Aar</ns1:clue><ns1:clue word="60" number="38" citation="vpis">priljubljen in nepogrešljiv pripomoček za dojenčke in malčke, namenjen zadovoljevanju njihovega naravnega sesalnega refleksa, ki jih pomirja in uspava</ns1:clue><ns1:clue word="61" number="39" citation="vpis">zgodovinsko mestece v angleški grofiji Berkshire, ki leži na levem bregu reke Temze, neposredno nasproti kraljevega Windsorja</ns1:clue><ns1:clue word="62" number="40" citation="vpis">suh, droben sneg, ki ga veter briše in nosi s seboj čez gorske grebene</ns1:clue><ns1:clue word="63" number="41" citation="vpis">priljubljena mobilna aplikacija za spletne zmenke in spoznavanje ljudi, ki je bila predstavljena leta 2012</ns1:clue><ns1:clue word="64" number="42" citation="vpis">tropska korenovka, ki izvira iz Afrike in Azije ter predstavlja enega najpomembnejših virov ogljikovih hidratov za milijone ljudi po vsem svetu</ns1:clue><ns1:clue word="65" number="45" citation="vpis">starodavno, antično ime za današnje mesto Štip v Severni Makedoniji</ns1:clue><ns1:clue word="66" number="46" citation="vpis">pomemben veletok v Srednji Aziji, ki teče skozi severozahodno Kitajsko in jugovzhodni Kazahstan, pritok Balhaškega jezera</ns1:clue><ns1:clue word="67" number="48" citation="vpis">oseba, katere pravo ime ali identiteta javnosti nista znana, sta namerno zamolčana ali pa sploh nista navedena (knjiž.)</ns1:clue><ns1:clue word="68" number="49" citation="vpis">reka v Slavoniji, levi pritok Orljave Hrvaška</ns1:clue><ns1:clue word="69" number="50" citation="vpis">ameriški znanstvenofantastični film Jamesa Camerona iz leta 2009</ns1:clue><ns1:clue word="70" number="52" citation="vpis">dekoracija, ali nekaj, kar služi za polepšavo, izboljšanje videza ali dodajanje estetske vrednosti nečemu; okras (knjiž.)</ns1:clue><ns1:clue word="71" number="54" citation="vpis">tradicionalni italijanski zeliščni liker, ki se v gastronomiji klasično streže kot digestiv po obroku za spodbujanje prebave</ns1:clue><ns1:clue word="72" number="56" citation="vpis">vhodni prostor ali predprostor v stanovanjski hiši, večstanovanjski stavbi ali javnem objektu</ns1:clue><ns1:clue word="73" number="57" citation="vpis">dve izžrebani številki v isti vrstici na tombolski srečki</ns1:clue><ns1:clue word="74" number="59" citation="vpis">ena najbolj prepoznavnih in inovativnih nemških avtomobilskih in motociklističnih znamk 20. stoletja (nekdaj)</ns1:clue><ns1:clue word="75" number="60" citation="vpis">kubanski intelektualec, diplomat, politik in pisatelj, zunanji minister - Raul (1907†1982)</ns1:clue><ns1:clue word="76" number="61" citation="vpis">idilična vas na Tirolskem, tik ob meji z Bavarsko, ki je svetovno znana po svojem pasijonskem gledališču</ns1:clue><ns1:clue word="77" number="62" citation="vpis">petnajsta črka arabske abecede</ns1:clue><ns1:clue word="78" number="64" citation="vpis">čebelja paša (star.)</ns1:clue></ns1:clues></ns1:crossword></ns1:rectangular-puzzle></ns0:crossword-compiler-applet>