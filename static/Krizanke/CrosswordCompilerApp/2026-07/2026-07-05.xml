-13" solution="RAK"/><word id="57" x="5" y="11-13" solution="OJO"/><word id="58" x="10" y="11-13" solution="GAL"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="perplexity">enota za merjenje jakosti električnega toka (fiz.)</clue><clue word="2" number="6" citation="vpis">najsjeverniji del otoka Velike Britanije in ena od držav, ki sestavljajo Združeno kraljestvo Velike Britanije in Severne Irske</clue><clue word="3" number="13" citation="vpis">ameriški igralec - Nick (1941-), (Rt strahu)</clue><clue word="4" number="14" citation="vpis">oseba, ki ljubi svojo domovino in je pripravljena delovati v njeno korist ali jo braniti, rodoljub</clue><clue word="5" number="15" citation="vpis">vojaško zavezništvo evropskih sil, ki so se med letoma 1803 in 1806 združile proti Napoleonu Bonaparteju (zgod.), (dve besedi)</clue><clue word="6" number="17" citation="vpis">457 km dolga reka v jugovzhodni Poljski, ki je desni pritok Visle in deloma tvori mejo z Ukrajino</clue><clue word="7" number="18" citation="vpis">(v indijski mitologiji) bog ognja in eden najpomembnejših božanstev vedskega obdobja</clue><clue word="8" number="19" citation="vpis">skupina ljudi, ki so povezani s skupnim ciljem in sodelujejo za njegovo dosego</clue><clue word="9" number="20" citation="vpis">zrela ženska spolna celica oziroma jajčece, ki je ključna za reprodukcijo (lat.)</clue><clue word="10" number="22" citation="vpis">skupek kovinskih elementov, kot so tečaji, sponke, kljuke, vijaki in drugi pritrdilni deli za vrata, okna, pohištvo ali lesene konstrukcije, okovje</clue><clue word="11" number="24" citation="vpis">ime slovenske pedagoginje, pisateljice in novinarke Peroci (1922†2001)</clue><clue word="12" number="25" citation="vpis">sporočilo, gib ali besedo, s katero nekomu nekaj nakažemo, ne da bi to povedali neposredno</clue><clue word="13" number="27" citation="vpis">polotok v Azerbajdžanu, ki se razteza 60 kilometrov globoko v Kaspijsko morje</clue><clue word="14" number="29" citation="vpis">čas štiriindvajsetih ur</clue><clue word="15" number="31" citation="vpis">termin za melodično, spevno skladbo ali stavek v suiti (glasb.)</clue><clue word="16" number="32" citation="vpis">miselnost ali ravnanje, ki temelji na neupoštevanju, zapostavljanju starejših</clue><clue word="17" number="36" citation="vpis">brezbarvna žgana alkoholna pijača z minimalno 37,5% alkohola, narejena z destilacijo žit ali krompirja in večkratnim filtriranjem za nevtralen okus</clue><clue word="18" number="40" citation="vpis">trajno in barvno simbolično znamenje, ki po določenih pravilih predstavlja državo, mesto, plemiško rodbino ali organizacijo ter izraža njihovo identiteto, zgodovino in vrednote</clue><clue word="19" number="41" citation="vpis">latinska beseda za prav tako ali isto, ki se v sodobnem jeziku uporablja kot oznaka za posamezno točko, predmet ali enoto na seznamu, v inventarju ali v računalniških podatkovnih strukturah</clue><clue word="20" number="43" citation="vpis">glavno in največje mesto Južne Koreje ter eno najpomembnejših svetovnih gospodarskih in tehnoloških središč</clue><clue word="21" number="44" citation="vpis">indijski pisatelj - Viveki (1924†2016), (Vstani, popotnik)</clue><clue word="22" number="45" citation="vpis">varjaški knez, ki je ob koncu 9. stoletja (leta 882) zavzel Kijev in ga razglasil za »mater ruskih mest« (?†ok. 912)</clue><clue word="23" number="47" citation="vpis">kratica za neznani leteči predmet</clue><clue word="24" number="48" citation="vpis">veda o človeku, ki celostno proučuje človeštvo v času in prostoru</clue><clue word="25" number="52" citation="vpis">pripadnik palestinskih oz.arabskih podtalnih ali terorističnih organizacij, ki označuje prostovoljnega borca ali gverilca, ki je pripravljen dati svoje življenje za verski ali nacionalni cilj</clue><clue word="26" number="53" citation="vpis">nekdanji izraelski vojaški poveljnik in politik, ki je med letoma 1999 in 2001 služil kot deseti predsednik vlade Izraela - Ehud (1942-)</clue><clue word="27" number="54" citation="vpis">gorovje, ki se razteza čez severozahodni del Benina ter sosednja Togo in Gano</clue><clue word="28" number="55" citation="vpis">rod sočnih rastlin (sukulent), ki obsega več kot 500 vrst, med katerimi je najbolj znana prava aloja (bot.)</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="29" number="1" citation="vpis">estonski hitrostni drsalec - Ants (1938†2015)</clue><clue word="30" number="2" citation="vpis">levi pritok Donave, ki teče skozi istoimensko zgodovinsko pokrajino (Moravsko) in tvori mejo med Slovaško in Avstrijo</clue><clue word="31" number="3" citation="vpis">zasedanje, na katerem so prisotni vsi člani določene organizacije, skupščine ali društva</clue><clue word="32" number="4" citation="vpis">nemški skladatelj in organist iz obdobja romantike, ki je deloval kot dvorni organist v cerkvi svetega Mihaela v Münchnu - Kaspar (1788†1847)</clue><clue word="33" number="5" citation="vpis">slovenski operni in koncertni pevec, tenorist, ki je s svojim žlahtnim glasom zaznamoval slovenski glasbeni prostor v drugi polovici 20. stoletja - Jurij (1936†2021)</clue><clue word="34" number="6" citation="vpis">ženska španske narodnosti</clue><clue word="35" number="7" citation="vpis">(v grški mitologiji) muza junaškega epa, poezije in filozofije, znana kot najstarejša in vodilna od devetih muz</clue><clue word="36" number="8" citation="vpis">reka v zahodni Afriki, ki izvira v Burkini Faso in teče tudi skozi Gano</clue><clue word="37" number="9" citation="vpis">gora v Vietnamu, "Opičja gora" zaradi divjih opic, ki tam živijo</clue><clue word="38" number="10" citation="vpis">material, nastal s postopkom sintranja, kjer se praškasti materiali pod vplivom toplote in pritiska spriječe v trdno maso, ne da bi se pri tem popolnoma raztalili (metal.)</clue><clue word="39" number="11" citation="vpis">osrednji dnevni obrok, ki ga običajno zaužijemo sredi dneva, med poldnevom in zgodnjim popoldnevom</clue><clue word="40" number="12" citation="vpis">zgodovinski naziv za vrhovnega vojaškega in civilnega voditelja pri Kozakih</clue><clue word="41" number="16" citation="vpis">vzdevek italijanskega motociklističnega dirkača Giacoma Agostinija (nekd.)</clue><clue word="42" number="21" citation="vpis">srednja dolžina oblačil, običajno kril ali oblek, ki segajo do sredine meč – nekje med dolžino "mini" (kratko) in "maxi" (do gležnjev) (žarg.)</clue><clue word="43" number="23" citation="vpis">strokovni izraz za kratek, trikotno ali vretenasto zožen šiv, s katerim se oblačilo prilagodi obliki telesa, všitek</clue><clue word="44" number="26" citation="vpis">(v islamskem svetu) častni naziv za vojščaka oziroma borca za vero</clue><clue word="45" number="28" citation="vpis">(v grški mitologiji) sin Aresa in Afrodite, bog ljubezni, poželenja in spolne privlačnosti</clue><clue word="46" number="30" citation="vpis">edini sesalec, ki je razvil sposobnost aktivnega letenja (zool.)</clue><clue word="47" number="32" citation="vpis">okrasni sklepni kamen na vrhu loka, ki vizualno "spne" obe strani oboka (arhit.)</clue><clue word="48" number="33" citation="vpis">francoski slikar in risar iz obdobja klasicizma in romantike - François  Marius (1775†1849)</clue><clue word="49" number="34" citation="vpis">poslovni izid pred obrestmi, davki in amortizacijo (ekon.)</clue><clue word="50" number="35" citation="vpis">kulturna rastlina iz družine bučnic z rumenim sladkim sadom</clue><clue word="51" number="37" citation="vpis">ameriški igralec, režiser in producent italijanskih korenin, ki velja za enega največjih filmskih umetnikov vseh časov - Robert (1943-), (Taksist)</clue><clue word="52" number="38" citation="vpis">slovenska voditeljica TV oddaj in prireditev, radijska moderatorka, imitatorka znanih osebnosti - Jasna (1981-)</clue><clue word="53" number="39" citation="vpis">južnoameriška vrsta kamele, ki živi v visokogorju Andov</clue><clue word="54" number="42" citation="vpis">drobir ali sipko gradivo (prah, pesek, drobno kamenje), ki nastaja s preperevanjem kamnin in se nabira ob vznožju gorskih sten ali na strmih pobočjih kot melišče</clue><clue word="55" number="46" citation="vpis">organizmi iz kraljestva gliv, ki niso niti rastline niti živali</clue><clue word="56" number="49" citation="vpis">pripadnik skupine členonožcev, ki večinoma živijo v vodi</clue><clue word="57" number="50" citation="vpis">staro nigerijsko kraljestvo v zvezni državi Lagos</clue><clue word="58" number="51" citation="vpis">nesistemska enota za merjenje gravitacijskega pospeška, ki se uporablja predvsem v geodeziji in geofiziki</clue></clues></crossword></rectangular-puzzle></crossword-compiler-applet>
