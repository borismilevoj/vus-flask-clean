><word id="57" x="14" y="7-15" solution="APARATURA"/><word id="58" x="15" y="7-10" solution="NOŠA"/><word id="59" x="5" y="8-10" solution="ISA"/><word id="60" x="9" y="8-11" solution="GANA"/><word id="61" x="8" y="9-11" solution="ČER"/><word id="62" x="7" y="10-15" solution="TURBAN"/><word id="63" x="1" y="11-15" solution="VNUKA"/><word id="64" x="2" y="11-15" solution="SIDON"/><word id="65" x="3" y="11-15" solution="EVERT"/><word id="66" x="4" y="11-15" solution="KELSO"/><word id="67" x="11" y="11-15" solution="VIKAR"/><word id="68" x="12" y="11-15" solution="AALTO"/><word id="69" x="5" y="12-15" solution="LEAN"/><word id="70" x="10" y="12-15" solution="ROMB"/><word id="71" x="15" y="12-15" solution="OKEN"/><word id="72" x="8" y="13-15" solution="ADA"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">kratek, oster ter bodičast podaljšek pleve, ki raste na žitnem klasu</clue><clue word="2" number="7" citation="vpis">obsežna kulturna in geografska regija na skrajnem severu Evrope, ki obsega severne dele Norveške, Švedske, Finske ter ruski polotok Kola</clue><clue word="3" number="15" citation="vpis">(v grški mitologiji) atiški heroj iz grške mitologije, ki je odigral ključno vlogo pri reševanju Aten pred uničenjem</clue><clue word="4" number="16" citation="vpis">medicinski in higienski pripomoček, namenjen izpiranju ali čiščenju telesnih votlin s tekočino</clue><clue word="5" number="17" citation="vpis">naslon, opora ali hrbtišče stola, klopi oziroma drugega pohištva za sedenje (knjiž.)</clue><clue word="6" number="18" citation="vpis">zgodovinska, pionirska kinematografska tehnika snemanja in predvajanja filmov na široko platno</clue><clue word="7" number="19" citation="vpis">arhaični, pokrajinski ali pogovorni izraz za mizarja oziroma obrtnika, ki izdeluje in popravlja pohištvo ter druge lesene izdelke</clue><clue word="8" number="20" citation="vpis">pripadnik avtohtonega prebivalstva Malajskega polotoka, obalnih delov otoka Sumatra in sosednjih manjših otokov v Jugovzhodni Aziji</clue><clue word="9" number="21" citation="vpis">ime britanske mladinske pisateljice Blyton (1897†1968)</clue><clue word="10" number="22" citation="vpis">protiletalski top oziroma protiletalska artilerija (voj.)</clue><clue word="11" number="24" citation="vpis">francoski igralec in režiser - Jacques (1909†1982), (Moj stric)</clue><clue word="12" number="25" citation="vpis">tradicionalen častni naziv, ki se uporablja kot izraz spoštovanja pred imenom moškega ali božanstva v indijski kulturi</clue><clue word="13" number="26" citation="vpis">količina pridelanih kulturnih rastlin na določeni površini (agr.)</clue><clue word="14" number="28" citation="vpis">struktura, nastala s prepletanjem treh ali več pramenov prožnega materiala</clue><clue word="15" number="30" citation="vpis">oster, izrazit rob gore ali stene, kjer se stikata dve steni pod kotom (alp.)</clue><clue word="16" number="31" citation="vpis">izmišljeni lik, ki ga je ustvaril ameriški pisatelj Edgar Rice Burroughs</clue><clue word="17" number="36" citation="vpis">žalna maša za umrle v Rimskokatoliški cerkvi (rel.)</clue><clue word="18" number="38" citation="vpis">tajna državna policija nacistične Nemčije, ustanovljena leta 1933 pod Hermannom Göringom kot orodje za zatiranje politične opozicije</clue><clue word="19" number="39" citation="vpis">pomembno industrijsko mesto v severozahodnem delu Irkutske oblasti v ruski Sibiriji</clue><clue word="20" number="40" citation="vpis">starodavna madžarska fevdalna rodbina, ki je imela ključno vlogo v politični in vojaški zgodovini Srednje Evrope, predvsem med 10. in 14. stoletjem</clue><clue word="21" number="41" citation="vpis">pripadnik nasilnih uličnih tolp v Parizu v začetku 20. stoletja</clue><clue word="22" number="42" citation="vpis">naprava, ki pretvarja elektromagnetno valovanje v električni tok in obratno (teh.)</clue><clue word="23" number="44" citation="vpis">omejeno obdobje ali doba z značilnimi razmerami, okoliščinami in dogodki, pogosto označena z zgodovinskim prelomom</clue><clue word="24" number="45" citation="perplexity">rez, zasek, utor ali vrezanje v trdo površino z ostrim orodjem, kot so sekira, dleto ali cepin</clue><clue word="25" number="49" citation="vpis">druga geološka perioda mezozoika, ki se je začela pred približno 201 milijoni let in zaključila pred 145 milijoni let (geol.)</clue><clue word="26" number="50" citation="vpis">rahel skupek bombažnih vlaken, ki so običajno očiščena in se uporabljajo za medicinske namene</clue><clue word="27" number="52" citation="vpis">geodetski instrument za merjenje višinskih razlik med točkami na terenu</clue><clue word="28" number="54" citation="vpis">najstarejši in najbolj znamenit od štirih mostov, ki prečkajo beneški Canal Grande, Italija</clue><clue word="29" number="56" citation="vpis">prisotnost, sodelovanje ali aktivno vključenost posameznika oziroma skupine pri določenem dogodku, procesu ali dejavnosti</clue><clue word="30" number="58" citation="vpis">izrazit, močno ukrivljen zavoj rečne struge v obliki črke S, ki nastane v spodnjem toku rek, kjer je strmec zgornjega površja zelo majhen</clue><clue word="31" number="59" citation="vpis">arheološko najdišče v severnem Iraku, blizu mesta Mosul, kjer so odkrili ostanke starodavnega asirskega mesta Dur-Šatrukin</clue><clue word="32" number="60" citation="vpis">nemški kipar, slikar in grafik, ki velja za enega ključnih predstavnikov klasične moderne umetnosti 20. stoletja - Ewald (1887†1965)</clue><clue word="33" number="61" citation="vpis">zgodovinsko naselje v občini Campezo (provinca Álava), Španija</clue><clue word="34" number="62" citation="vpis">vrhunski slovenski alpinist, gorski reševalec letalec in inštruktor iz Mojstrane - Janez (1947-)</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="35" number="1" citation="vpis">eden najbolj plodovitih in priljubljenih hrvaških književnikov 20. stoletja - Ivan (1921†1987), (