word id="56" x="8" y="6-10" solution="AMATI"/><word id="57" x="5" y="7-9" solution="ŠME"/><word id="58" x="11" y="7-9" solution="ŽRD"/><word id="59" x="4" y="8-11" solution="RIAL"/><word id="60" x="9" y="8-10" solution="BOŽ"/><word id="61" x="10" y="8-10" solution="UDA"/><word id="62" x="1" y="9-11" solution="HON"/><word id="63" x="15" y="9-11" solution="APE"/><word id="64" x="6" y="10-15" solution="ADULAR"/><word id="65" x="7" y="10-12" solution="DAH"/><word id="66" x="12" y="10-15" solution="DLESEN"/><word id="67" x="5" y="11-15" solution="ASPRA"/><word id="68" x="11" y="11-15" solution="BLATO"/><word id="69" x="8" y="12-15" solution="ATEJ"/><word id="70" x="9" y="12-15" solution="DAZA"/><word id="71" x="10" y="12-15" solution="OKOP"/><word id="72" x="1" y="13-15" solution="KSI"/><word id="73" x="2" y="13-15" solution="RAZ"/><word id="74" x="3" y="13-15" solution="AHO"/><word id="75" x="4" y="13-15" solution="MAB"/><word id="76" x="13" y="13-15" solution="ARS"/><word id="77" x="14" y="13-15" solution="KIK"/><word id="78" x="15" y="13-15" solution="IKA"/><clues ordering="normal"><title><b>Across</b></title><clue word="1" number="1" citation="vpis">športnik, ki profesionalno ali rekreacijsko igra košarko, enega najbolj priljubljenih, dinamičnih in množičnih kolektivnih športov z žogo na svetu</clue><clue word="2" number="9">otok v Andamanskem morju, Tajska</clue><clue word="3" number="15" citation="vpis">svetlobni sij, ki obdaja celotno telo svetnika, božanstva ali Marije, kar ponazarja njihovo nebeško slavo, svetost in božansko naravo</clue><clue word="4" number="16" citation="vpis">zahodna mongolska etnična skupina, ki govori oiratščino in obsega podskupine kot so Kalmiki, Dorbeti, Torguti in Zungari, zgodovinsko naseljeni v Dzungariji in Kalmikiji</clue><clue word="5" number="17" citation="vpis">vrstni krožni pospeševalnik osnovnih delcev, ki je bil razvit posebej za pospeševanje elektronov (beta delcev) do izjemno visokih hitrosti in energij (fiz.)</clue><clue word="6" number="18" citation="vpis">oseba, s katero smo v družbenem stiku, jo poznamo po imenu in z njo občasno poklepetamo, vendar z njo nimamo globoke čustvene vezi ali tesnega zaupnega odnosa, ki je značilen za prijateljstvo</clue><clue word="7" number="19" citation="vpis">prevozno sredstvo, napravo ali pohištvo s štirimi sedeži</clue><clue word="8" number="21" citation="vpis">eden najbolj vplivnih, slavnih in inovativnih jazzovskih glasbenikov v zgodovini - Miles (1926†1991)</clue><clue word="9" number="24" citation="vpis">glavno mesto Združenih arabskih emiratov (ZAE) in hkrati prestolnica istoimenskega, največjega izmed sedmih emiratov</clue><clue word="10" number="29" citation="vpis">kratica za Mednarodno banko za rekonstrukcijo in razvoj</clue><clue word="11" number="30" citation="vpis">ozka, uhojena ali umetno narejena pot v naravi, namenjena pešcem, kolesarjem ali živalim</clue><clue word="12" number="33">histrski kralj, vladal je v Istri v obdobju od leta 181 pr. n. št. do 177 pr. n. št.</clue><clue word="13" number="34" citation="vpis">akcija ali gib, s katerim človek z zamahom roke zavihti in izpusti predmet, z namenom, da ta poleti skozi zrak proti določenemu cilju ali doseže čim večjo razdaljo</clue><clue word="14" number="35" citation="vpis">privlačnost, očarljivost in sposobnost, da nekdo s svojim vedenjem, govorom ali videzom pritegne in navduši druge (knjiž.)</clue><clue word="15" number="36" citation="vpis">boleča razpoka, rdečica ali vnetje v kotičku ust (med.)</clue><clue word="16" number="37" citation="vpis">monumentalna scenska kantata, ki jo je med letoma 1935 in 1936 zložil nemški skladatelj Carl Orff (dve besedi)</clue><clue word="17" number="41" citation="vpis">norveško-ameriška  umetnostna drsalka in hollywoodska filmska zvezda - Sonja (1912†1969)</clue><clue word="18" number="42">ameriška igralka - Thelma (1906†1935)</clue><clue word="19" number="43" citation="vpis">(v grški mitologiji) domovina in zibelka dveh najslavnejših antičnih čarovnic – Medeje in njene tete Kirke</clue><clue word="20" number="45" citation="vpis">nekdanji irski profesionalni nogometaš in nogometni trener - Darren (1987-)</clue><clue word="21" number="46" citation="vpis">druga najdaljša reka v Italiji, ki izvira na Južnem Tirolskem v Retijskih Alpah</clue><clue word="22" number="48" citation="vpis">splošno uveljavljen izraz za robustno, terensko športno vozilo (SUV) z višjim podvozjem, ki je primarno zasnovano za vožnjo po zahtevnih, neurejenih terenih, blatu, snegu in strminah</clue><clue word="23" number="49" citation="vpis">podatek o skupnem številu natisnjenih izvodov posamezne izdaje knjige, časopisa, revije, stripa ali katerega koli drugega tiskanega gradiva (tisk.)</clue><clue word="24" number="51" citation="vpis">hrvaška televizijska voditeljica in producentka - Antonija (1979-)</clue><clue word="25" number="52">razpotegnjeno naselje jugozahodno od Kamnika</clue><clue word="26" number="56" citation="vpis">vrhunska slovenska športna plezalka, ki spada v sam svetovni vrh, specializirana pa je predvsem za težavnostno in kombinirano plezanje - Mia (2000-)</clue><clue word="27" number="60" citation="vpis">pomembno zgodovinsko in industrijsko mesto v prefekturi Gunma v osrednjem delu japonskega otoka Honšu</clue><clue word="28" number="64">največja peščena puščava na svetu, Afrika</clue><clue word="29" number="65" citation="vpis">oseba, ki se ukvarja notranjim, skritim znanjem onkraj običajnega razumevanja, kot so mistika, astrologija ali okultizem</clue><clue word="30" number="66" citation="vpis">(v meteorologiji) črta na vremenski karti, ki povezuje kraje z enakim zračnim tlakom, preračunanim na morsko gladino</clue><clue word="31" number="67" citation="vpis">otoška država v Vzhodni Aziji, ki leži v Tihem oceanu ob vzhodni obali azijske celine z glavnim mestom Tokio</clue></clues><clues ordering="normal"><title><b>Down</b></title><clue word="32" number="1" citation="vpis">kratica za osrednjo sovjetsko varnostno-obveščeva