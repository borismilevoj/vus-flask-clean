 id="57" x="13" y="9-15" solution="AMILOID"/><word id="58" x="14" y="9-15" solution="MODELER"/><word id="59" x="1" y="10-15" solution="PLITKA"/><word id="60" x="15" y="10-15" solution="KACURA"/><word id="61" x="5" y="11-15" solution="ZARIS"/><word id="62" x="10" y="11-15" solution="NANOS"/><word id="63" x="6" y="12-15" solution="RICA"/><word id="64" x="11" y="12-15" solution="HANK"/><clues ordering="normal"><title><b>Across</b></title><clue word="1" number="1">starogrški matematik (ok.280 pr.n.š.†ok.210 pr.n.š.), Nikomedes</clue><clue word="2" number="8" citation="perplexity">kamerunski košarkar - Pascal (1994-)</clue><clue word="3" number="14" citation="vpis">nekdanji potopljeni otok na reki Donavi, ki je do leta 1970 ležal na meji med Romunijo in Srbijo ter je v zgodovini veljal za zadnjo uradno turško eksklavo v Srednji Evropi (dve besedi)</clue><clue word="4" number="15" citation="vpis">starinski in knjižni izraz za podsedelno odejo ali pregrinjalo za konja</clue><clue word="5" number="16" citation="vpis">irski protestantski duhovnik, dramatik in pisatelj, ki se je v zgodovino zapisal kot eden zadnjih in najvplivnejših mojstrov gotskega romana - Charles Robert (1782†1824)</clue><clue word="6" number="17" citation="vpis">izjemno odporna, netopna vlaknata beljakovina, ki predstavlja osnovni gradnik zunanjih zaščitnih struktur pri človeku in živalih</clue><clue word="7" number="18" citation="vpis">sodobna ruska skladateljica, kantavtorica, pesnica in gledališka umetnica - Tatjana (1961-)</clue><clue word="8" number="19" citation="vpis">tradicionalna japonska umetnost zgibanja papirja v najrazličnejše okrasne in figuralne oblike</clue><clue word="9" number="20" citation="vpis">tradicionalna in brezčasna pričeska, oblikovana s prepletanjem treh ali več pramenov las</clue><clue word="10" number="21" citation="vpis">avstralska hard rock skupina, ustanovljena leta 1973 v Sydneyju s strani bratov Angusa in Malcolma Younga</clue><clue word="11" number="23" citation="vpis">pogovorni in žargonski izraz za barvno tehniko ter barvno snemanje v fotografiji, kinematografiji in televiziji</clue><clue word="12" number="24" citation="vpis">slavna ameriška pisateljica - Jean Marie (1936-), (Otroci Zemlje)</clue><clue word="13" number="25" citation="vpis">naravna padavina v trdnem stanju, ki se pojavi neposredno na zemeljski površini ali predmetih, predvsem na vejah in listju dreves</clue><clue word="14" number="27" citation="vpis">stalno in najvišje cerkveno prizivno sodišče, ki odloča o sodbah nižjih sodišč, posebej v zvezi s sklenitvijo cerkvene zakonske zveze (rel.)</clue><clue word="15" number="28" citation="perplexity">morski sesalec z velikima okloma in brki</clue><clue word="16" number="30" citation="vpis">hrvaški  pesnik, šansonjer, pisatelj, novinar in akademik - Jakša (1946†2018)</clue><clue word="17" number="32" citation="vpis">papirnat denar, ki se je uporabljal zlasti v času francoske revolucije</clue><clue word="18" number="34">kraj v Grčiji</clue><clue word="19" number="37" citation="vpis">izraelsko-francoski kipar in slikar - Yaacov (1928†2026)</clue><clue word="20" number="41" citation="vpis">zgornji del trupa pri človeku in nekaterih drugih živih bitjih, ki se nahaja med vratom in trebuhom (anat.)</clue><clue word="21" number="42" citation="vpis">beseda ali besedna zveza, nastala z dobesednim prevodom iz tujega jezika</clue><clue word="22" number="43" citation="vpis">stanje duševne razdraženosti, ki se stopnjuje v besnost in ubijalsko manijo, zlasti znano iz kulture Malajcev</clue><clue word="23" number="45">ameriška pevka in igralka - Jennifer (1969-), (Načrtovalka porok)</clue><clue word="24" number="47" citation="vpis">vrhunski ameriški filmski režiser, scenarist in producent, ki je najbolj znan po več kot tri desetletja dolgem sodelovanju z mlajšim bratom Ethanom - Joel (1954-), (Fargo)</clue><clue word="25" number="49" citation="vpis">serpentina, vijuga ali oster cestni ovinek (nar.)</clue><clue word="26" number="50" ci