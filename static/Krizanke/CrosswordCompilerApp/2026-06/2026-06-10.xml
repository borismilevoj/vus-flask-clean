solution="BRAS"/><word id="56" x="13" y="6-10" solution="LAUDA"/><word id="57" x="14" y="6-10" solution="KRMED"/><word id="58" x="15" y="6-10" solution="AGARA"/><word id="59" x="7" y="7-10" solution="TIEN"/><word id="60" x="8" y="7-9" solution="EFA"/><word id="61" x="10" y="8-11" solution="NYON"/><word id="62" x="11" y="8-13" solution="TRDOTA"/><word id="63" x="4" y="9-15" solution="PAŠTETA"/><word id="64" x="12" y="9-15" solution="IVAKUNI"/><word id="65" x="5" y="10-15" solution="VARDAR"/><word id="66" x="6" y="10-12" solution="AŠA"/><word id="67" x="8" y="11-15" solution="ŠAPKA"/><word id="68" x="9" y="11-15" solution="ESINO"/><word id="69" x="1" y="12-15" solution="KOCA"/><word id="70" x="2" y="12-15" solution="OBER"/><word id="71" x="3" y="12-15" solution="NJUH"/><word id="72" x="7" y="12-15" solution="BEAL"/><word id="73" x="13" y="12-15" solution="IRAK"/><word id="74" x="14" y="12-15" solution="VUGA"/><word id="75" x="15" y="12-15" solution="OMAR"/><word id="76" x="10" y="13-15" solution="DAN"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">pogovorni izraz za vožnjo ali prevoz, pogosto z vozilom ali tovornjakom</clue><clue word="2" number="5" citation="vpis">najstarejše mesto v Sloveniji, ki se nahaja v Podravju ob reki Dravi</clue><clue word="3" number="9" citation="vpis">oprema (vprega), ki se jo namesti konju okoli vratu, da lahko vleče voz ali plug</clue><clue word="4" number="14" citation="vpis">najmanjši delček nekega elementa, ki lahko vstopa v kemične reakcije (kem.)</clue><clue word="5" number="15" citation="vpis">(v grški mitologiji) ena izmed petih rek podzemlja (Hada)</clue><clue word="6" number="16" citation="vpis">naselje in občina v osrednjem delu Sardinije v Italiji, ki se nahaja v provinci Nuoro</clue><clue word="7" number="17" citation="vpis">prevladujoča skupina kopenskih živali, ki so kraljevale na Zemlji v obdobju mezozoika  (pal.)</clue><clue word="8" number="19" citation="vpis">slovenski slikar - Robert (1967-)</clue><clue word="9" number="20" citation="vpis">slovenski košarkarski trener - Gašper (1973-)</clue><clue word="10" number="21" citation="vpis">fascinantna skupina izključno morskih živali, ki jih prepoznamo po nekaterih edinstvenih lastnostih, ki jih nima nobena druga skupina živali</clue><clue word="11" number="23" citation="vpis">največja odvodna krvna žila v telesu, ki jo imenujemo tudi velika telesna odvodnica (anat.)</clue><clue word="12" number="25" citation="vpis">otrok moškega spola v odnosu do svojih staršev</clue><clue word="13" number="26" citation="vpis">eno najbolj priljubljenih izletniških mest v osrednji Sloveniji, predvsem zaradi Zbiljskega jezera, ki leži ob robu naselja v občini Medvode</clue><clue word="14" number="29" citation="vpis">specializirana ura, katere primarna naloga je oddajanje zvočnega, svetlobnega ali vibracijskega signala ob točno določenem času, najpogosteje z namenom prebujanja iz spanca</clue><clue word="15" number="33" citation="vpis">močna simbolna vez med študentom in njegovo izobraževalno ustanovo (lat.), (dve besedi)</clue><clue word="16" number="36" citation="vpis">strateško izjemno pomemben otok v Perzijskem zalivu, ki pripada Iranu</clue><clue word="17" number="37" citation="vpis">tretja potenca števila (mat.)</clue><clue word="18" number="38" citation="vpis">prestižen lovski in signalni rog, izdelan iz celega slonovega okla</clue><clue word="19" number="41" citation="vpis">ime ameriške igralke Thurman (1970-), (Pulp Fiction)</clue><clue word="20" number="42" citation="vpis">rusko-nemški režiser - Fedor (1895†1949), (Bratje Karamazovi)</clue><clue word="21" number="44" citation="vpis">kultni ameriški film iz leta 1969 (v slovenščini znanem kot Goli v sedlu), v katerem igrata Peter Fonda in Dennis Hopper in ki velja za simbol svobode ter hipijevske subkulture</clue><clue word="22" number="46" citation="vpis">premična pregrada ali zaslon, ki deli prostor, ščiti pred pogledom ali vetrom, pogosto zložljiv ali na tirnicah (knjiž.)</clue><clue word="23" number="49" citation="vpis">proces spreminjanja naučenih vedenjskih vzorcev, ki nam škodujejo ali nas ovirajo, odvajanje (star.)</clue><clue word="24" number="50" citation="vpis">rod trajnih zelenih rastlin iz družine ostričevk, ki običajno uspevajo na vlažnih tleh ali ob stoječih vodah in so prepoznavne po svojih ostrih, trirobrih steblih</clue><clue word="25" number="51" citation="vpis">hrvaški pisatelj - August (1838†1881), (Zlatarjevo zlato)</clue><clue word="26" number="53" citation="vpis">godalni instrument z najnižjim tonskim obsegom (muz.)</clue><clue word="27" number="57" citation="vpis">skupina celic, ki so si podobne po obliki, zgradbi in opravljajo isto nalogo (biol.)</clue><clue word="28" number="61" citation="vpis">travniška rastlina z modrimi cvetovi, navadni potrošnik (star.)</clue><clue word="29" number="62" citation="vpis">antično ime za Cavtat</clue><clue word="30" number="64" citation="vpis">španska avtonomna mestna eksklava na severni obali Afrike, ki meji na Maroko in je znana kot strateška točka ob Gibraltarski ožini</clue><clue word="31" number="65" citation="vpis">bolezen kože, ki se kaže z različnimi spremembami – predvsem v obliki mozoljev, papul, pustul, komedonov (ogrcev) in v hujših primerih tudi cist ali nodul (med.)</clue><clue word="32" number="66" citation="vpis">sumerska boginja pisanja, učenja in žetve, Nisaba</clue><clue word="33" number="67" citation="vpis">slovenski pravnik in bančnik - France (1948-)</clue><clue word="34" number="68" citation="vpis">mesto v severni Franciji, v departmaju Aisne v regiji Hauts-de-France</clue><clue word="35" number="69" citation="vpis">(v grški mitologiji)  sin mojstrskega izumitelja Dedala, najbolj znan po svojem tragičnem poletu proti soncu</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="36" number="1" citation="vpis">tradicionalna portugalska glasbena zvrst, značilna je po melanholičnih besedilih, ki izraža