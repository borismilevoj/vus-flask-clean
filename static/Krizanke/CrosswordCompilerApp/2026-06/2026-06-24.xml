="55" x="6" y="4-8" solution="TRIAS"/><word id="56" x="10" y="4-6" solution="VIS"/><word id="57" x="8" y="5-11" solution="DATIRKA"/><word id="58" x="1" y="6-10" solution="POKOL"/><word id="59" x="2" y="6-10" solution="AROSA"/><word id="60" x="3" y="6-10" solution="TAROM"/><word id="61" x="7" y="6-9" solution="ŽREB"/><word id="62" x="12" y="6-9" solution="DRSA"/><word id="63" x="13" y="6-10" solution="AŠRAM"/><word id="64" x="14" y="6-10" solution="KASSA"/><word id="65" x="15" y="6-10" solution="ARTEL"/><word id="66" x="4" y="7-10" solution="NAJA"/><word id="67" x="9" y="7-10" solution="ENIA"/><word id="68" x="10" y="8-12" solution="ENARE"/><word id="69" x="5" y="9-14" solution="ARNAČE"/><word id="70" x="6" y="10-12" solution="RUM"/><word id="71" x="11" y="10-15" solution="SULFAT"/><word id="72" x="7" y="11-15" solution="LIGAŠ"/><word id="73" x="12" y="11-15" solution="SFERA"/><word id="74" x="1" y="12-15" solution="OGON"/><word id="75" x="2" y="12-15" solution="RAPE"/><word id="76" x="3" y="12-15" solution="IRAN"/><word id="77" x="4" y="12-15" solution="GALI"/><word id="78" x="9" y="12-15" solution="BATA"/><word id="79" x="13" y="12-15" solution="ARAR"/><word id="80" x="14" y="12-15" solution="SATO"/><word id="81" x="15" y="12-15" solution="TLAK"/><word id="82" x="8" y="13-15" solution="EGO"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">srednje velika močvirska ptica iz družine tukalic (zool.)</clue><clue word="2" number="6" citation="vpis">tradicionalna tržnica ali trgovska četrt v arabskih in nekaterih drugih bližnjevzhodnih mestih</clue><clue word="3" number="9" citation="vpis">mesto in sedež istoimenske občine v Bosni in Hercegovini, ki ležijo le nekaj kilometrov jugovzhodno od glavnega mesta Sarajevo</clue><clue word="4" number="13" citation="perplexity">učinek dela, ki ni vezan na čas</clue><clue word="5" number="14" citation="vpis">legendarni italijanski mestni avtomobil (supermini), ki ga je koncern Fiat predstavil leta 1983 kot zamenjavo za uspešen, a zastarel model Fiat 127</clue><clue word="6" number="15" citation="vpis">velik trikoten polotok na stiku med Afriko in Azijo ter hkrati edini del Egipta, ki leži na azijski celini</clue><clue word="7" number="16" citation="vpis">močno čustveno, mentalno ali zavestno nagnjenje do določenega objekta, osebe, stanja ali cilja, ki ga posameznik v tistem trenutku nima, a si ga hoče pridobiti</clue><clue word="8" number="17" citation="peplexity">daljši kos blaga ali pletenine, ki se nosi zlasti okrog vratu</clue><clue word="9" number="18" citation="vpis">ruska atletinja, metalka kopja in diska - Tamara (1937†2021)</clue><clue word="10" number="19" citation="vpis">politična in vojaška zveza med Francijo, Veliko Britanijo in Rusijo, ki se je oblikovala pred prvo svetovno vojno</clue><clue word="11" number="21" citation="vpis">oseba, ki je usposobljena za ravnanje z letalom, letalec</clue><clue word="12" number="23" citation="vpis">prostor v cerkvi namenjen za duhovnike, prezbiterij</clue><clue word="13" number="24" citation="vpis">nadnaravno bitje iz arabske in širše islamske mitologije</clue><clue word="14" number="25" citation="vpis">poseben položaj v šahovski igri, pri katerem igralec, ki je na potezi, nima na voljo nobene zakonite (dovoljene) poteze, njegov kralj pa hkrati ni v šahu (napaden), (šah.)</clue><clue word="15" number="28" citation="vpis">ljudski ali pogovorni izraz za melodijo, pesem ali napev</clue><clue word="16" number="30" citation="vpis">ameriški pop pevec, pianist in izjemno plodovit delujoč avtor številnih zimzelenih uspešnic - Neil (1939†2026)</clue><clue word="17" number="35" citation="vpis">drugo največje mesto v Alžiriji in pomembno kulturno, zgodovinsko in gospodarsko središče na severozahodu države</clue><clue word="18" number="37" citation="perplexity">smer v sodobni italijanski umetnosti (um.)</clue><clue word="19" number="39" citation="vpis">slovenski kipar - Drago (1927†2023)</clue><clue word="20" number="40" citation="vpis">tradicionalno strunsko glasbilo, ki izvira iz Zahodne Afrike in je značilno predvsem za kulturo ljudstva Mandinka (območja današnje Gambije, Senegala, Malija in Gvineje). Gre za izjemen hibrid med harfo in lutnjo</clue><clue word="21" number="41" citation="vpis">ena najbolj znanih in opevanih evropskih rek, ki teče skozi osrčje Francije, Sena</clue><clue word="22" number="43" citation="vpis">krovna dlaka sesalcev, ki žival varuje pred zunanjimi vplivi</clue><clue word="23" number="44" citation="vpis">območje, kraj ali celotno stran hriba, ki je obrnjena stran od sonca</clue><clue word="24" number="46" citation="vpis">rod trpežnih, zimzelenih iglavcev iz družine cipresovk</clue><clue word="25" number="47" citation="vpis">mati glavnega junaka v slovitem dramskem delu Peer Gynt norveškega pisatelja Henrika Ibsena</clue><clue word="26" number="48" citation="vpis">avstrijsko-ameriška igralka - Hedy (1914†2000), (Samson in Delilah)</clue><clue word="27" number="50" citation="vpis">francoska pevka - Patricia (1966-)</clue><clue word="28" number="52" citation="vpis">slovenski mladinski pisatelj, filmski snemalec in scenarist - Vitan (1946-), (Vanda)</clue><clue word="29" number="53" citation="vpis">pogovorni izraz za številko ali številsko vrednost nič (0)</clue><clue word="30" number="55" citation="vpis">slovenski geograf in zgodovinar - Jože (1888†1945)</clue><clue word="31" number="57" citation="vpis">tradicionalna japonska umetnost zgibanja papirja v najrazličnejše okrasne in figuralne oblike</clue><clue word="32" number="61" citation="vpis">glavno in največje mesto Severne Irske ter drugo največje mesto na irskem otoku (takoj za Dublinom)</clue><clue word="33" number="65" citation="vpis">izjemno delaven, marljiv in neutruden človek</clue><clue word="34" number="66" citation="vpis">(v grški mitologiji) boginja zemlje, Gaja</clue><clue word="35" number="68" citation="vpis">prenosna svetilka na plin ali petrolej (nar.)</clue><clue word="36" 