"6" solution="PALIR"/><word id="16" x="3-11" y="7" solution="ČEBOKSARI"/><word id="17" x="1-5" y="8" solution="STERI"/><word id="18" x="7-9" y="8" solution="AEK"/><word id="19" x="11-13" y="8" solution="STP"/><word id="20" x="1-4" y="9" solution="LAVA"/><word id="21" x="8-13" y="9" solution="SEKTAR"/><word id="22" x="1-5" y="10" solution="ERATO"/><word id="23" x="7-13" y="10" solution="KATANGA"/><word id="24" x="1-8" y="11" solution="PELAGIAL"/><word id="25" x="10-13" y="11" solution="RIOM"/><word id="26" x="1-3" y="12" solution="ANK"/><word id="27" x="5-8" y="12" solution="EMRE"/><word id="28" x="10-13" y="12" solution="ACRE"/><word id="29" x="1-3" y="13" solution="RTA"/><word id="30" x="5-8" y="13" solution="NERC"/><word id="31" x="10-13" y="13" solution="JAEN"/><word id="32" x="1" y="1-6" solution="JERIŠA"/><word id="33" x="2" y="1-6" solution="AMONIT"/><word id="34" x="3" y="1-13" solution="URESNIČEVALKA"/><word id="35" x="4" y="1-5" solution="KIRIJ"/><word id="36" x="6" y="1-7" solution="FIDELIO"/><word id="37" x="7" y="1-4" solution="AGER"/><word id="38" x="8" y="1-3" solution="KOP"/><word id="39" x="9" y="1-4" solution="TRAK"/><word id="40" x="11" y="1-13" solution="OSTROLISTNICA"/><word id="41" x="12" y="1-6" solution="ROMANI"/><word id="42" x="13" y="1-6" solution="TRASER"/><word id="43" x="10" y="3-7" solution="RIBAR"/><word id="44" x="5" y="4-8" solution="DERBI"/><word id="45" x="7" y="6-8" solution="SKA"/><word id="46" x="9" y="6-10" solution="PAKET"/><word id="47" x="4" y="7-11" solution="ERATA"/><word id="48" x="8" y="7-13" solution="SESALEC"/><word id="49" x="1" y="8-13" solution="SLEPAR"/><word id="50" x="2" y="8-13" solution="TARENT"/><word id="51" x="12" y="8-13" solution="TAGORE"/><word id="52" x="13" y="8-13" solution="PRAMEN"/><word id="53" x="10" y="9-13" solution="KARAJ"/><word id="54" x="5" y="10-13" solution="OGEN"/><word id="55" x="7" y="10-13" solution="KARR"/><word id="56" x="6" y="11-13" solution="IME"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">slovenski novinar, urednik in avtor  - Franček (1943-)</clue><clue word="2" number="5" citation="vpis">nekaj, kar dejansko obstaja ali se je v resnici zgodilo.</clue><clue word="3" number="9" citation="vpis">enotni vektor v matematiki</clue><clue word="4" number="12" citation="vpis">slovenski znanstvenik, strojni inženir, akademik ter eden izmed vodilnih svetovnih strokovnjakov na področju mehanike časovno odvisnih materialov - Igor (1952-)</clue><clue word="5" number="13" citation="vpis">ena najbolj znanih zgodovinskih slovenskih sort krompirja, ki so jo v začetku šestdesetih let prejšnjega stoletja vzgojili na Kmetijskem inštitutu Slovenije (agr.)</clue><clue word="6" number="14" citation="vpis">glivična okužba ustne sluznice, ki se najpogosteje pojavi pri dojenčkih ali osebah z oslabljenim imunskim sistemom kot bele obloge na jeziku (med.)</clue><clue word="7" number="15" citation="vpis">reka, ki teče skozi Belgijo, Nemčijo in Nizozemsko</clue><clue word="8" number="16" citation="vpis">francoska upravno-ozemeljska enota</clue><clue word="9" number="18" citation="vpis">dobro obveščen človek iz ozadja oziroma oseba, ki je del neke skupnosti in ima dostop do zaupnih informacij</clue><clue word="10" number="20" citation="vpis">trden prsni oklep brez rokavov, ki je varoval trup vojaka (nekd.)</clue><clue word="11" number="21" citation="vpis">težek, dolg vojaški plašč iz debelega volnenega blaga (voj.)</clue><clue word="12" number="22" citation="vpis">nekdanji naziv pristanišča Annaba, Alžirija</clue><clue word="13" number="23" citation="vpis">ata, oče (ljubk.)</clue><clue word="14" number="24" citation="vpis">velika divja mačka, ki živi v gozdovih Evrope in Azije. Je znan po svojih značilnih čopkih na ušesih in kratkem repu</clue><clue word="15" number="26" citation="vpis">oseba, ki vodi in nadzoruje potek gradbenih del, zagotavlja skladnost izvedbe z načrti in predpisi ter koordinira delo med izvajalci in naročniki</clue><clue word="16" number="27" citation="vpis">glavno mesto Čuvašije, Ruska federacija</clue><clue word="17" number="30" citation="vpis">seneni drobir, oziroma drobni, odlomljeni koščki suhega sena (nar.)</clue><clue word="18" number="32" citation="vpis">atensko športno društvo</clue><clue word="19" number="33" citation="vpis">uradna okrajšava za Sao Tome in Principe</clue><clue word="20" number="36" citation="vpis">staljena kamnina (magma), ki ob izbruhu vulkana prodre na površje Zemlje</clue><clue word="21" number="37" citation="vpis">pripadnik ali privrženec zaprte verske oziroma nazorske skupine (sekte), (knjiž.)</clue><clue word="22" number="39" citation="vpis">(v grški mitologiji) ena izmed devetih muz, muza ljubezenske (erotične) poezije in himn</clue><clue word="23" number="41" citation="vpis">zgodovinska in nekdanja administrativna regija v jugovzhodnem delu Demokratične republike Kongo</clue><clue word="24" number="42" citation="vpis">odprto morje oziroma celotna prosta vodna masa, ki ni v neposrednem stiku z obalo ali dnom (geogr.)</clue><clue word="25" number="44" citation="vpis">zgodovinsko mesto v departmaju Puy-de-Dôme v regiji Auvergne-Rhône-Alpes, Francija</clue><clue word="26" number="45" citation="vpis">četrti rimski kralj, ki je vladal približno med letoma 640 pr. n. št. in 616 pr. n. št. - Marcij</clue><clue word="27" number="46" citation="vpis">eden največjih in najvplivnejših turških ljudskih pesnikov ter sufijskih mistikov - Yunus (ok. 1240†ok. 1321)</clue><clue word="28" number="47" citation="vpis">zvezna država na skrajnem zahodu Brazilije, ki leži v osrčju amazonskega pragozda</clue><clue word="29" number="48" citation="vpis">naravni in kozmični red, ki vzdržuje ravnovesje v vesolju (v indijski filozofiji in Vedah)</clue><clue word="30" number="49" citation="vpis">kuni podobna mesojeda žival, ki živi ob vodah in je znana po dragocenem krznu</clue><clue word="31" number="50" citation="vpis">mesto in istoimenska provinca v avtonomni skupnosti Andaluzija na jugu Španije</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="32" number="1" citation="vpis">slovenski pesnik, prevajalec in jezikoslovec - Fran (1829†1855), (Slovenska deklica)</clue><clue word="33" number="2" citation="vpis">fosilna školjka izumrlih cefalopodov, ki so živeli od devona do konca krede pred 66 milijoni let (pal.)</clue><clue word="34" number="3" citation="vpis">ženska, ki določene načrte, ideje ali cilje prenese iz teorije v prakso ter jih dejansko izpolni</clue><clue word="35" number="4" citation="vpis">umetni element, ki ima v periodnem sistemu simbol Cm in atomsko število 96</clue><clue word="36" number="5" citation="vpis">opera v dveh dejanjih nemškega skladatelja L. van Beethovna</clue><clue word="37" number="6" citation="vpis">kanadski skladatelj, znan predvsem po svojih operah, simfonijah in komorni glasbi - Andrew (1962-)</clue><clue word="38" number="7" citation="vpis">prostor na površini zemlje, kjer se koplje ruda</clue><clue word="39" number="8" citation="vpis">dolg, ozek in tanek kos materiala, kot je blago, guma, kovina ali drug material</clue><clue word="40" number="9" citation="vpis">ljudsko oziroma narečno ime za zimzeleni grm bodiko (božji les), znan po svojih bodičastih listih in rdečih plodovih</clue><clue word="41" number="10" citation="vpis">pripadniki romanskih narodov oziroma potomci starih Rimljanov, ki govorijo romanske jezike (npr. Italijani, Francozi, Španci, Romuni ...).</clue><clue word="42" number="11" citation="vpis">v diagnostiki snov (pogosto radioaktivna ali fluorescentna), ki jo vnesemo v telo, da bi spremljali določene procese (med.)</clue><clue word="43" number="17" citation="vpis">oseba, ki prodaja ribe oziroma ribje izdelke</clue><clue word="44" number="19" citation="vpis">odločilno športno tekmovanje med velikima tekmecema</clue><clue word="45" number="25" citation="vpis">glasbena zvrst, ki je nastala na Jamajki v poznih 50-ih letih prejšnjega stoletja</clue><clue word="46" number="26" citation="vpis">poštna pošiljka, ki ima določeno velikost, težo, vrednost in embalažo</clue><clue word="47" number="28" citation="vpis">založniški izraz za seznam tiskarskih napak in njihovih popravkov, ki je priložen tiskani knjigi</clue><clue word="48" number="29" citation="vpis">pripadnik najvišje razvite skupine vretenčarjev, pri kateri samice svoje mladiče hranijo z mlekom</clue><clue word="49" number="30" citation="vpis">izraz za nepoštenega človeka, ki z lažmi, prevarami in hlinjenjem zavaja ter izkorišča druge (ekspr.)</clue><clue word="50" number="31" citation="vpis">slovensko ime za italijansko mesto Taranto</clue><clue word="51" number="34" citation="vpis">indijski pisatelj in guru - Rabindranath, nobelovec leta 1913 (1861†1941), (Gora)</clue><clue word="52" number="35" citation="vpis">manjši šop las</clue><clue word="53" number="38" citation="vpis">veliko in pomembno mesto v Iranu, ki leži približno 20 kilometrov zahodno od prestolnice Teheran, ob vznožju gorovja Alborz</clue><clue word="54" number="40" citation="vpis">slovenski pesnik, prevajalec, urednik in filmski kritik s pravim imenom Miro Boštjančič - Mart (1939†1998), (Dediščina)</clue><clue word="55" number="41" citation="perplexity">ameriška pisateljica in pesnica - Mary (1954†2021), (Klub lažnivcev)</clue><clue word="56" number="43" citation="vpis">beseda ali niz besed, s katerimi označujemo posameznika, predmet, kraj, žival ali koncept, da ga lahko prepoznamo in razlikujemo od drugih</clue></clues></crossword></rectangular-puzzle></crossword-compiler-applet>
