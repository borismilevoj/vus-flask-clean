ord id="56" x="5" y="6-10" solution="ADAMO"/><word id="57" x="11" y="6-10" solution="LIJAK"/><word id="58" x="6" y="7-11" solution="ADAMS"/><word id="59" x="7" y="8-15" solution="AGAPENOR"/><word id="60" x="12" y="8-11" solution="AMUR"/><word id="61" x="1" y="9-13" solution="OMELO"/><word id="62" x="8" y="9-12" solution="AMAN"/><word id="63" x="15" y="9-13" solution="ANAMI"/><word id="64" x="9" y="10-15" solution="AKADEM"/><word id="65" x="4" y="11-15" solution="PAKET"/><word id="66" x="10" y="11-15" solution="AROMA"/><word id="67" x="5" y="12-15" solution="KRKA"/><word id="68" x="11" y="12-15" solution="ELON"/><word id="69" x="6" y="13-15" solution="OLI"/><word id="70" x="12" y="13-15" solution="FNT"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">tradicionalno azijsko prevozno sredstvo, ki temelji na človeški moči ali pogonu s pedali</clue><clue word="2" number="6" citation="vpis">slikovito srednjeveško mesto na severozahodu Francije, v regiji Bretanija, ki velja za enega najbolje ohranjenih zgodovinskih biserov v državi</clue><clue word="3" number="11" citation="vpis">eden najpomembnejših bogov v starodavni mezopotamski mitologiji (sumerski, akadski, babilonstki in asirski)</clue><clue word="4" number="12" citation="vpis">določeno, sklenjeno območje ali površino z natančno določenim namenom oziroma značilnostjo</clue><clue word="5" number="13" citation="vpis">državna zastava, pod katero pluje določena ladja (navt.)</clue><clue word="6" number="15" citation="vpis">pokrito vhodno preddverje starokrščanskih in bizantinskih bazilik ter nekaterih kasnejših cerkva (arhit.)</clue><clue word="7" number="18" citation="vpis">umetniško ime angleškega pevca, glasbenika in igralca Stuart Leslieja Goddarda - Adam (1954-)</clue><clue word="8" number="19" citation="vpis">pripadnik turškega ljudstva, ki danes živi predvsem v Tatarstanu (del Rusije) in na Krimu</clue><clue word="9" number="21" citation="vpis">manjši potok ali vodotok, ki se kot desni pritok izliva v reko Savinjo pri kraju Rečica ob Savinji</clue><clue word="10" number="22" citation="vpis">osnovni koncept v indijski klasični glasbi, ki predstavlja posebno zaporedje tonov, uporabljeno za ustvarjanje melodije (glasb.)</clue><clue word="11" number="24" citation="vpis">slovenski dramski igralec, komik, režiser in pevec - Jurij (1970-), (Belo se pere na 90)</clue><clue word="12" number="26" citation="vpis">manjša naravna ali erozijska oblika v rečni strugi ali drugem vodnem toku, kjer se ustvari lokalno poglobljen del z mirnejšo vodo (nar.)</clue><clue word="13" number="27" citation="vpis">strojni element, namenjen fiksiranju, podpiranju ali obešanju različnih bremen, cevi ali konstrukcijskih delov (avt.)</clue><clue word="14" number="29" citation="vpis">oseba, ki jo nekdo občuduje in ji želi biti podoben</clue><clue word="15" number="31" citation="vpis">kratica za ribonukleinsko kislino (biol.)</clue><clue word="16" number="32" citation="vpis">država v Severni Ameriki z glavnim mestom Ottawa</clue><clue word="17" number="34" citation="vpis">majhno mesto v regiji Lacij, približno 100 km južno od Rima v pokrajini Latina</clue><clue word="18" number="35" citation="vpis">ime slovenske radijske moderatorke in TV voditeljice Širca Roš (1979-)</clue><clue word="19" number="36" citation="vpis">gost kozmetični pripravek, ki se uporablja predvsem za oblikovanje las ali nego kože (knjiž.)</clue><clue word="20" number="38" citation="vpis">japonski pisatelj - Juji (1961-), (Stratos 4)</clue><clue word="21" number="40" citation="vpis">estonski pevec, baritonist - Georg (1920†1975)</clue><clue word="22" number="41" citation="vpis">politični slogan Donalda Trumpa iz njegovih predsedniških kampanj (2016, 2020, 2024)</clue><clue word="23" number="43" citation="vpis">dinamično palestinsko mesto na Zahodnem bregu, ki leži približno 10 kilometrov severno od Jeruzalema</clue><clue word="24" number="45" citation="vpis">mikavnost, privlačnost (knjiž.)</clue><clue word="25" number="46" citation="vpis">stanje čutnega in duševnega ugodja, kjer se zmanjša zavedanje sebe in okolice, pogosto povezano z užitkom ali omamljenostjo (knjiž.)</clue><clue word="26" number="48" citation="vpis">ena najvidnejših slovenskih strokovnjakinj na področju varstva potrošnikov in dolgoletna predsednica Zveze potrošnikov Slovenije (ZPS) - Breda (1954-)</clue><clue word="27" number="49" citation="vpis">grški basnopisec (ok. 6. stoletja pr. n. š.), (Starec in smrt)</clue><clue word="28" number="51" citation="vpis">grimasa, izkrivljen, nenaraven izraz obraza, pogosto z negativnim prizvokom</clue><clue word="29" number="53" citation="vpis">sistematična in načrtna skrb za domače živali z namenom pridobivanja različnih dobrin, kot so hrana (meso, mleko, jajca), surovine (volna, usnje)</clue><clue word="30" number="54" citation="vpis">tiskana ali ročno izdelana pola papirja, namenjena javnemu obveščanju, oglaševanju ali vizualni komunikaciji na javnih mestih</clue><clue word="31" number="56" citation="vpis">jezero na Finskem, tudi Inari</clue><clue word="32" number="58" citation="vpis">uradno, spoštljivo in politično korektno ime za pripadnika romskega naroda</clue><clue word="33" number="59" citation="vpis">petnajsta črka grške abecede</clue><clue word="34" number="61" citation="vpis">nekdanji vrhunski italijanski umetnostni drsalec, ki danes deluje kot priznan trener in športni komentator - Angelo (1978-)</clue><clue word="35" number="63" citation="vpis">ena najpomembnejših in najbolj razširjenih tehničnih zlitin, sestavljena predvsem iz železa in majhnega deleža ogljika (običajno do 2 %</clue><clue word="36" number="64" citation="vpis">rimska naselbina, ki je stala na območju današnje Ljubljane</clue><clue word="37" number="65" citation="vpis">najsvetlejša zvezda v ozvezdju Orla in dvanajsta najsvetlejša zvezda na celotnem nočnem nebu</clue><clue word="38" number="66" citation="vpis">pogovorni izraz za plašč</clue></clues><clues ordering="nor