<word id="90" x="17" y="13-17" solution="TANSI"/><word id="91" x="9" y="14-17" solution="ALAO"/><word id="92" x="10" y="14-17" solution="GERS"/><word id="93" x="14" y="14-17" solution="INRI"/><word id="94" x="6" y="15-17" solution="IVO"/><word id="95" x="7" y="15-17" solution="VID"/><word id="96" x="8" y="15-17" solution="APN"/><clues ordering="normal"><title><b>Vodoravno</b></title><clue word="1" number="1" citation="vpis">biblijski izraz za moj služabnik ali božji služabnik</clue><clue word="2" number="5" citation="vpis">informativna tabla ali plakat, pritrjen na steno v šolah, tovarnah, uradih ali vojašnicah, stenski časopis (pog.)</clue><clue word="3" number="12" citation="vpis">ameriški profesionalni boksar in družbeni aktivist, ki velja za najboljšega boksarja v težki kategoriji vseh časov - Muhammad (1942†2016)</clue><clue word="4" number="15" citation="vpis">reka v jugozahodni Franciji, desni pritok reke Adour</clue><clue word="5" number="17" citation="vpis">japonski režiser - Hirokazu (1962-), (Kakršen oče, takšen sin)</clue><clue word="6" number="18" citation="vpis">sled, ki jo pusti oster predmet</clue><clue word="7" number="19" citation="vpis">umetniško ime nizozemske pevke Anike Bostelaar (1981-)</clue><clue word="8" number="20" citation="vpis">ustvarjalna in intelektualna dejavnost sestavljanja ter reševanja ugank, križank in drugih miselnih procesov</clue><clue word="9" number="22" citation="vpis">veriga stopnic, ki jih poganja električni motor in se krožno premikajo navzgor ali navzdol, tekoče stopnice (teh.)</clue><clue word="10" number="24" citation="vpis">neurejena, neobvladljiva ali nasilna skupino ljudi (slabš.)</clue><clue word="11" number="25" citation="vpis">groba, močna in gosta tkanina, običajno stkana iz volne ali mešanice volne in lana, raševina</clue><clue word="12" number="26" citation="vpis">63. cesar Japonske iz dinastije Yamato (867†931)</clue><clue word="13" number="27" citation="vpis">slikovito pristaniško mesto na zahodni obali Norveške, znano predvsem po svoji edinstveni arhitekturi v slogu art nouveau (jugendstil) in dramatični lokaciji na več otokih</clue><clue word="14" number="30" citation="vpis">samostojna tekstilna tvorba, ki nastane s prepletanjem, vozlanjem ali vezanjem niti</clue><clue word="15" number="32" citation="vpis">ptica, ki je znana po svojem zapletenem in melodičnem oglašanju</clue><clue word="16" number="34" citation="vpis">ena najstarejših in gospodarsko najpomembnejših kulturnih rastlin pri nas</clue><clue word="17" number="35" citation="vpis">ime in priimek angleškega glasbenika, bobnarja (The Beatles), (1940-)</clue><clue word="18" number="38" citation="vpis">francoski departma v regiji Grand Est na severovzhodu države z glavnim mestom Troyes</clue><clue word="19" number="41" citation="vpis">(v Nemčiji in nekaterih drugih severnoevropskih državah) oznaka za upravno okrožje ali urad, ki združuje več manjših občin</clue><clue word="20" number="42" citation="vpis">v slovenskem kmetijstvu in tradiciji najpomembnejša vrsta domačih živali. Spada v družino votlorogov in je ključni vir mleka, mesa ter usnja</clue><clue word="21" number="47" citation="vpis">kompleksno človeško čustvo, ki združuje dve na videz nasprotujoči si občutji: globoko spoštovanje  in hkrati določeno mero strahu ali ponižnosti pred nečim, kar nas presega (ekspr.)</clue><clue word="22" number="52" citation="vpis">slovenska psihologinja in izredna profesorica razvojne psihologije - Simona (1946-)</clue><clue word="23" number="53" citation="vpis">reka na Poljskem, desni pritok reke Warte, ki je ena od glavnih rek zahodne Poljske</clue><clue word="24" number="54" citation="vpis">mesto in okraj v provinci Kerman v Iranu, ki je znano po kmetijstvu, predvsem po pridelavi pistacij</clue><clue word="25" number="55" citation="vpis">eden najpomembnejših starogrških filozofov, ki velja za očeta ontologije (ok. 510†450 pr. n. š.)</clue><clue word="26" number="60" citation="vpis">zgodovinska regija na severovzhodu Slovaške in delno na jugu Poljske, znana po srednjeveških mestih, gradovih in rudnikih</clue><clue word="27" number="64" citation="vpis">ena najstarejših in najprestižnejših ameriških avtomobilskih znamk, ki sodi pod okrilje koncerna General Motors (GM)</clue><clue word="28" number="65" citation="vpis">pisni ukaz ali odlok, ki ga izda turški sultan</clue><clue word="29" number="68" citation="vpis">razlika med dvema ali več lastnostmi, ki so si neposredno nasprotne</clue><clue word="30" number="70" citation="vpis">znamenit gorski masiv v Montblanški skupini nad dolino Chamonix v francoskih Alpah</clue><clue word="31" number="71" citation="vpis">švicarski zdravnik in dramatik - Arnold (1840†1910), (Karel Drzni)</clue><clue word="32" number="73" citation="vpis">ukaz, povelje ali strogo navodilo (zastar.)</clue><clue word="33" number="74" citation="vpis">živahno obmorsko mesto na severozahodni konici Portorika</clue><clue word="34" number="77" citation="vpis">oseba ali naprava, ki nekaj prikriva, taji ali dela neopazno</clue><clue word="35" number="81" citation="vpis">britanski igralec - John (1935†2007)</clue><clue word="36" number="82" citation="vpis">močan vodni tok, ki se premika v spiralastih zavojih; smrk, vodni vrtinec</clue><clue word="37" number="83" citation="vpis">živali, ki ležejo jajca</clue><clue word="38" number="84" citation="vpis">spremenjeno stanje zavesti, ki ga zaznamujejo globoka osredotočenost, zmanjšana dovzetnost za zunanje dražljaje in pogosto občutek zamaknjenosti</clue><clue word="39" number="85" citation="vpis">evropska vesoljska agencija</clue><clue word="40" number="86" citation="vpis">stanje, ko je nekaj doseglo svojo optimalno stopnjo razvoja, zrelosti ali uporabnosti</clue><clue word="41" number="87" citation="vpis">glavni sončni bog v mitologiji Inkov, starodavne civilizacije, ki je živela na območju današnjega Peruja in okoliških držav</clue></clues><clues ordering="normal"><title><b>Navpično</b></title><clue word="42" number="1" citation="vpis">eden najbolj priljubljenih ameriških otroških igralcev v 50. letih prejšnjega stoletja - Lee (1943†2021), (Rin Tin Tin)</clue><clue word="43" number="2" citation="vpis">del tiskarskega stroja, ki z valjev ali plošč briše odvečno barvo (tisk.)</clue><clue word="44" number="3" citation="vpis">manjši zaselek ali del naselja v bližini Velike Nedelje v občini Ormož</clue><clue word="45" number="4" citation="vpis">najbolj znana opera, ki jo je napisal angleško-avstralski skladatelj William Marshall-Hall leta 1890</clue><clue word="46" number="5" citation="vpis">svež, mehki mlečni izdelek, narejen iz koagulirane sirotke ali mleka z rahlo kiselkasto aromo</clue><clue word="47" number="6" citation="vpis">država na zahodu Afrike med Beninom in Gano z glavnim mestom Lome</clue><clue word="48" number="7" citation="vpis">državno premoženje (jur.)</clue><clue word="49" number="8" citation="vpis">ena od pomembnih rek v Mandžuriji oziroma na območju Severovzhodne kitajske nižine</clue><clue word="50" number="9" citation="vpis">denarna nakaznica oziroma vrednostni papir, s katerim izdajatelj daje nalog svoji banki, naj prinosniku čeka izplača določeno vsoto denarja ali pa to vsoto prenese na njegov račun</clue><clue word="51" number="10" citation="vpis">mestno naselje in središče istoimenske občine v severni Srbiji, natančneje v avtonomni pokrajini Vojvodini</clue><clue word="52" number="11" citation="vpis">nekdanje glavno mesto antičnega Lidijskega kraljestva</clue><clue word="53" number="12" citation="vpis">ameriška igralka - Beatrice ""Bea"" (1922†2009), (Zlata dekleta)</clue><clue word="54" number="13" citation="vpis">zgodovinska in geografska regija v vzhodnem Sredozemlju, ki obsega obalne zemlje od Grčije do Egipta</clue><clue word="55" number="14" citation="vpis">v keltski legendi Tristanova ljubica, kjer po nesreči popijeta ljubezenski napoj, ki ju veže v večno, a prepovedano ljubezen</clue><clue word="56" number="16" citation="vpis">ena najstarejših in najbolj plemenitih pasem psov na svetu, perzijski hrt</clue><clue word="57" number="21" citation="vpis">krovna dlaka sesalcev, ki žival varuje pred zunanjimi vplivi</clue><clue word="58" number="23" citation="vpis">francoski slikar in ilustrator - Louis Emile (1839†1937)</clue><clue word="59" number="27" citation="vpis">prostor za mejno črto igrišča (šport.)</clue><clue word="60" number="28" citation="vpis">starodavno pristanišče v Izraelu, Akko, Acca, Akka, Akon</clue><clue word="61" number="29" citation="vpis">glasbeni izraz, ki označuje počasno in širok tempo oziroma hitrost izvajanja skladbe (muz.)</clue><clue word="62" number="31" citation="vpis">slovenska operna pevka,  sopranistka - Muršič, Vera  (1903†1983)</clue><clue word="63" number="32" citation="vpis">izrazito razkošje, sijaj in slovesnost, ki spremlja določene dogodke ali nastope (pog.)</clue><clue word="64" number="33" citation="vpis">moški pripadnik ugrofinskega naroda, ki je prvotno poseljen v državi Estonija na severovzhodni obali Baltskega morja</clue><clue word="65" number="36" citation="vpis">snov v plinastem agregatnem stanju (pog.)</clue><clue word="66" number="37" citation="vpis">vodoraven ali nagnjen hodnik v rudniku, ki služi za dostop do rudišča ali odvoz materiala (mont.)</clue><clue word="67" number="38" citation="vpis">nemški filozof in jezikoslovec - Georg Anton Friedrich (1778†1841)</clue><clue word="68" number="39" citation="vpis">manjši pomožni objekt na vrtu ali na dvorišču, ki je namenjen shranjevanju orodja, koles, vrtnarskih pripomočkov ali pa kot delavnica oziroma prostor za različne dejavnosti</clue><clue word="69" number="40" citation="vpis">rjava barva tal, kar je pogosto sinonim za kakovostno in rodovitno prst (nar.)</clue><clue word="70" number="43" citation="vpis">mesto na zahodni obali Finske, upravno središče pokrajine Ostrobotnija</clue><clue word="71" number="44" citation="vpis">nekdanji vrhunski avstrijski alpski smučar, ki je bil specialist za tehnične discipline, predvsem veleslalom - Hans (1958-)</clue><clue word="72" number="45" citation="vpis">reka v Kamerunu (Afrika), ki teče skozi obsežne pragozdove in je znana po istoimenskem naravnem rezervatu, ki je pod zaščito Unesca</clue><clue word="73" number="46" citation="vpis">(v danščini in norveščini) drobni denar oziroma stotin krone</clue><clue word="74" number="48" citation="vpis">zelo kratek čas, trenutek (pog.)</clue><clue word="75" number="49" citation="vpis">gnus, odpor ali nekaj zoprnega, gnusobnega (knjiž.)</clue><clue word="76" number="50" citation="vpis">dar, darilo (pog.)</clue><clue word="77" number="51" citation="vpis">število 3</clue><clue word="78" number="56" citation="vpis">slovenski sociolog - Veljko (1929†2018)</clue><clue word="79" number="57" citation="vpis">pripoved ali zgodba, ki pojasnjuje naravne pojave, izvor sveta, bogove, junake in običaje v okviru določene kulture ali religije</clue><clue word="80" number="58" citation="vpis">preprost, nizek kmečki voz z ravno nakladalno ploskvijo, ki nima stranic (lojtric), (pog.)</clue><clue word="81" number="59" citation="vpis">oseba z izjemno širokim in globokim znanjem, ki ga je pridobil s sistematičnim študijem, branjem in raziskovanjem (knjiž.)</clue><clue word="82" number="60" citation="vpis">glavno in največje mesto Severne Makedonije</clue><clue word="83" number="61" citation="vpis">kostariški nogometaš, vratar - Jose (1970-) (nekd.)</clue><clue word="84" number="62" citation="vpis">ime prve in doslej edine predsednica vlade Indije Gandhi  (1917†1984)</clue><clue word="85" number="63" citation="vpis">velika ptica iz družine štork, ki je znana po svoji značilni podobi: dolgih nogah, dolgih vratu in kljunu ter belem perju z nekaj črnimi peresi na krilih, štorklja (nar.)</clue><clue word="86" number="66" citation="vpis">kratek, tesno oprijet vojaški suknjič, ki so ga nosili husarji (lahka konjenica) v 18. in 19. stoletju</clue><clue word="87" number="67" citation="vpis">postava moškega, ki podpira razne stavbne elemente (um.)</clue><clue word="88" number="69" citation="vpis">velik morski rak brez klešč, značilen za Jadransko morje, z rdečkasto-rjavo lupino, belkastimi pikami in dolgimi tipalkam (zool.)</clue><clue word="89" number="70" citation="vpis">enota za količino, ki vsebuje 12 kosov</clue><clue word="90" number="72" citation="vpis">kongovski pisatelj in pesnik - Sony Labou (1947†1995), (Antiljudje)</clue><clue word="91" number="74" citation="vpis">nigerijsko-britanska raziskovalka demence - Abimbola (1967-)</clue><clue word="92" number="75" citation="vpis">reka v jugozahodni Franciji, levi pritok Garone</clue><clue word="93" number="76" citation="vpis">napis na Kristusovem križu, ki ga je dal pritrditi Poncij Pilat na križ nad glavo Jezusa Kristusa</clue><clue word="94" number="78" citation="vpis">ime slovenskega podjetnika ustanovitelja podjetja Pipistrel Boscarola</clue><clue word="95" number="79" citation="vpis">eno od petih osnovnih čutov pri človeku in živalih, ki omogoča zaznavanje svetlobe, barv, oblik in gibanja ter s tem zaznavo okolice</clue><clue word="96" number="80" citation="vpis">ruska poročevalna agencija, ustanovljena leta 1961 kot naslednica dotedanjega Sovjetskega informacijskega biroja</clue></clues></crossword></rectangular-puzzle></crossword-compiler-applet>
